const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file
const User = require('./models/User');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
});

afterEach(async () => {
  await User.deleteMany({});
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

// ==========================================================================
// ⚛️ SUITE 24: REAL-TIME STELLARIUM & QUANTUM ABILITY ENGINE CHECKS
// ==========================================================================
describe('Archverse Stellarium Calculation and Quantum Wave Function Tests', () => {

  it('should successfully compute real-time Keplerian orbital vectors via the Stellarium controller', async () => {
    const response = await request(app)
      .get('/api/celestial/stellarium-tick')
      .send();

    expect(response.status).toBe(200);
    expect(response.body.success).toBe(true);
    expect(response.body.stellariumState.ophanimCoordinates.x).toBeDefined();
    expect(response.body.stellariumState.siderealTimeDegrees).toBeLessThan(360);
  });
});
