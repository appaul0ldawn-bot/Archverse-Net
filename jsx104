import React, { useState } from 'react';

export function AngelicLotteryHUD({ currentUsername, userTokens, activePoolId }) {
  const [phraseInput, setPhraseInput] = useState('');
  const [outcomeReport, setOutcomeReport] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);

  const checkSacredPhrase = async () => {
    if (!phraseInput.trim()) return;
    setIsProcessing(true);

    try {
      const response = await fetch('/api/lottery/submit-ticket', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username: currentUsername,
          sacredPhraseText: phraseInput.trim(),
          activePoolId: activePoolId
        })
      });
      const data = await response.json();
      if (data.success) {
        setOutcomeReport(data);
        setPhraseInput('');
      } else {
        alert(`❌ Cipher Error: ${data.error}`);
      }
    } catch (e) {
      console.error("Failed to connect with the Gematria matrix engine:", e);
    } finally {
      setIsProcessing(false);
    }
  };

  return (
    <div className="storefront-overlay-wrapper" style={{ top: '55%', left: '760px', width: '350px', borderColor: '#fbbf24' }}>
      <div className="store-header">
        <h3 style={{ margin: 0, color: '#fbbf24', fontFamily: 'serif' }}>🔮 Universal Angelic Gematria Matrix</h3>
      </div>

      <p style={{ fontSize: '11px', color: '#cbd5e1', margin: '4px 0 12px 0', textAlign: 'left' }}>
        Submit phrases to compute English alphanumeric weights. Manifest matching Angel Numbers (111, 444, 777) to claim the daily jackpot rewards.
      </p>

      {/* Interactive Phrase Entry Terminal */}
      <div style={{ display: 'flex', gap: '4px', marginBottom: '12px' }}>
        <input 
          type="text" value={phraseInput} onChange={(e) => setPhraseInput(e.target.value)}
          placeholder="Type prophetic text phrase... (e.g., Archverse)"
          style={{ flex: 1, background: 'rgba(0,0,0,0.5)', border: '1px solid #fbbf24', padding: '8px', color: '#fff', borderRadius: '6px', fontSize: '12px' }}
        />
        <button onClick={checkSacredPhrase} disabled={isProcessing} className="buy-upgrade-btn" style={{ padding: '8px', background: '#fbbf24', color: '#0f172a', fontWeight: 'bold' }}>
          {isProcessing ? 'Sync...' : 'Cast'}
        </button>
      </div>

      {/* Outcome Metric Reporting Displays */}
      {outcomeReport && (
        <div style={{ background: 'rgba(234,179,8,0.06)', border: '1px solid #eab308', padding: '12px', borderRadius: '10px', textAlign: 'left', fontSize: '11px', lineHeight: 1.4 }}>
          <span style={{ color: '#34d399', fontWeight: 'bold', display: 'block', marginBottom: '4px' }}>✅ {outcomeReport.message}</span>
          <div>• Computed Gematria Sum: <strong>{outcomeReport.gematriaSum}</strong></div>
          <div>• Numerological Single Reduction: <strong style={{ color: '#a5b4fc' }}>Digit {outcomeReport.masterReductionDigit}</strong></div>
          <div style={{ color: '#94a3b8', fontSize: '9px', marginTop: '4px' }}>Ticket Fee processed via Token Vault. Remaining: 🪙 {outcomeReport.updatedBalance} ST</div>
        </div>
      )}
    </div>
  );
}
