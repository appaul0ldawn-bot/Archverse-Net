const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file

describe('Archverse Multiverse Web and Downloadable App Integration Integrity', () => {

  it('should verify that the central ecosystem router holds valid URLs and correctly parses descriptors', () => {
    const { ARCHVERSE_LINK_ECOSYSTEM } = require('./EcosystemRouter');

    // Test specific high-value integration lines explicitly to catch dead parameters
    const libraryTarget = ARCHVERSE_LINK_ECOSYSTEM.library_nodes.find(
      (n) => n.title === "Sethian Gnosticism & Platonic Tradition"
    );
    expect(libraryTarget).toBeDefined();
    expect(libraryTarget.url).toContain('https://gnosis.study');

    const trackingTarget = ARCHVERSE_LINK_ECOSYSTEM.radar_nodes.find(
      (n) => n.title === "Alien Detector & Radar"
    );
    expect(trackingTarget).toBeDefined();
    expect(trackingTarget.url).toContain('play.google.com');
  });

  it('should cleanly serve the ecosystem payload across secure REST API endpoints for client map parsing', async () => {
    const response = await request(app)
      .get('/api/ecosystem/manifest-links') // Simulation route definition mapping
      .send();

    expect(response.status).toBe(200);
    expect(response.body.success).toBe(true);
    expect(response.body.payload.store_nodes.length).toBeGreaterThan(0);
  });
});
