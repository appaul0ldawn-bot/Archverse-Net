import React, { useState, useEffect } from 'react';

export function SimsRightHUD({ currentUsername, socket }) {
  const [vortexLog, setVortexLog] = useState(null);
  const [isSyncing, setIsSyncing] = useState(false);

  useEffect(() => {
    socket.emit('request_sims_right_vortex_data', { username: currentUsername });
    socket.on('sims_right_vortex_payload', (data) => {
      setVortexLog(data);
    });
    return () => socket.off('sims_right_vortex_payload');
  }, [currentUsername, socket]);

  const triggerVortexSorting = async () => {
    setIsSyncing(true);
    try {
      const response = await fetch('/api/vortex/sort-accomplishment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username: currentUsername,
          completedMissionId: "ms_proc_zion_777",
          sessionEffortMinutes: 45,
          activeCoordinates: [31.7683, 35.2137]
        })
      });
      const data = await response.json();
      if (data.success) {
        setVortexLog(data);
      }
    } catch (e) {
      console.error("Vortex connection handshake drop:", e);
    } finally {
      setIsSyncing(false);
    }
  };

  return (
    <div className="storefront-overlay-wrapper" style={{
      top: '10%', left: '24px', width: '380px', maxHeight: '82%',
      background: 'linear-gradient(135deg, rgba(15,23,42,0.98) 0%, rgba(234,179,8,0.03) 100%)',
      border: '2px solid #fbbf24', borderRadius: '24px', boxShadow: '0 0 25px rgba(234,179,8,0.15)' // Gold Glow Shroud
    }}>
      <div className="store-header" style={{ borderColor: 'rgba(234,179,8,0.2)', paddingBottom: '10px' }}>
        <h3 style={{ margin: 0, color: '#fbbf24', fontFamily: 'serif', letterSpacing: '0.04em' }}>🌪️ Sim’s Right: Morality Vortex</h3>
        <span style={{ fontSize: '9px', color: '#94a3b8' }}>Dante’s Counterpart Filter Array • Virtues Rank Oversight</span>
      </div>

      <div style={{ padding: '12px', display: 'flex', flexDirection: 'column', gap: '10px', fontSize: '11px', textAlign: 'left' }}>
        
        {/* --- YIN-YANG POLARITY EQUILIBRIUM GRAPHIC DATA CARD --- */}
        {vortexLog ? (
          <div style={{ background: 'rgba(0,0,0,0.4)', padding: '12px', borderRadius: '12px', border: '1px solid rgba(234,179,8,0.1)' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ color: '#fbbf24', fontWeight: 'bold' }}>⚖️ Polarity Sorting Status:</span>
              <span style={{ 
                fontWeight: 'bold', 
                color: vortexLog.vortexAudit === 'BALANCED_HARMONY' ? '#34d399' : '#ef4444',
                textShadow: vortexLog.vortexAudit === 'BALANCED_HARMONY' ? '0 0 4px #10b981' : '0 0 4px #ef4444'
              }}>
                {vortexLog.vortexAudit.replace('_', ' ')}
              </span>
            </div>
            
            {/* Visual Balance Progress Slider Bar */}
            <div style={{ width: '100%', height: '4px', background: '#334155', borderRadius: '2px', marginTop: '8px', position: 'relative' }}>
              <div style={{ 
                position: 'absolute', 
                left: `${Math.min(100, Math.max(0, (vortexLog.equilibriumMetrics.balanceRatio / 2) * 100))}%`, 
                top: '-4px', width: '12px', height: '12px', borderRadius: '50%', 
                background: '#fbbf24', boxShadow: '0 0 8px #fbbf24' 
              }} />
            </div>
            
            <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '9px', color: '#64748b', marginTop: '4px' }}>
              <span>Yin (Expansion): {vortexLog.equilibriumMetrics.yinLightScale}</span>
              <span>Yang (Grounding): {vortexLog.equilibriumMetrics.yangGroundScale}</span>
            </div>
          </div>
        ) : (
          <div style={{ color: '#64748b', fontStyle: 'italic' }}>Awaiting accomplishment telemetry payload ingestion ticks...</div>
        )}

        {/* --- REWARDS AND ACCENSION PLACEMENTS INSPECTOR --- */}
        {vortexLog && (
          <div style={{ background: 'rgba(255,255,255,0.01)', padding: '10px', borderRadius: '8px', border: '1px solid rgba(255,255,255,0.03)', display: 'flex', flexDirection: 'column', gap: '4px' }}>
            <div className="metric-row"><span>🪙 Filtered Token Yield:</span><strong style={{ color: '#34d399' }}>+{vortexLog.rewardsAllocated.tokensPaid} Angel Tokens</strong></div>
            <div className="metric-row"><span>🏰 Unlocked 7 Heavens Sphere:</span><span style={{ color: '#a5b4fc', fontWeight: 'bold' }}>{vortexLog.rewardsAllocated.unlockedSphereRank}</span></div>
          </div>
        )}

        <button 
          onClick={triggerVortexSorting} disabled={isSyncing}
          className="buy-upgrade-btn" style={{ width: '100%', background: 'linear-gradient(45deg, #b45309, #d97706)', color: '#fff', fontWeight: 'bold', fontSize: '11px', padding: '8px' }}
        >
          {isSyncing ? '🔄 Calibrating Scale Tensors...' : '🌪️ Ingest & Sort Latest Accomplishment'}
        </button>

      </div>
    </div>
  );
}
