const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file
const User = require('./models/User');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
});

afterEach(async () => {
  await User.deleteMany({});
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

// ==========================================================================
// 🏠 SUITE 7: PASSPHRASES, CONSENTED ENTRY, AND MODERATION LOOPS
// ==========================================================================
describe('Archverse Threshold Consent and Sacred Passphrase Verification', () => {

  it('should accept character registration if the password matches the 4-word sacred passphrase rule', async () => {
    const validPayload = {
      username: 'HolyTemplar',
      email: 'templar@archverse.net',
      birthdate: '1990-05-12',
      sacredPassphrase: 'The Light Reigns Eternal' // 4 words - Valid
    };

    const response = await request(app).post('/api/auth/register-intent').send(validPayload);
    expect(response.status).toBe(200);
    expect(response.body.success).toBe(true);
  });

  it('should reject interaction requests and kick players if seduction actions cross into harassment thresholds', async () => {
    const sender = await User.create({ username: 'SpammyDemon', tokens: 500, warningCount: 0 });
    const target = await User.create({ username: 'ProtectedAngel', tokens: 100, blockedUsersList: [] });

    // Simulate clicking the player rapidly 5 times to force a harassment trigger loop execution
    let response;
    for (let i = 0; i < 5; i++) {
      response = await request(app)
        .post('/api/interaction/seduce')
        .send({ senderUsername: 'SpammyDemon', targetUsername: 'ProtectedAngel' });
    }

    expect(response.body.actionStatus).toBe('BOOTED_FOR_HARASSMENT');

    const checkSender = await User.findOne({ username: 'SpammyDemon' });
    expect(checkSender.warningCount).toBe(1);
    expect(checkSender.tokens).toBe(200); // 500 base - 300 harassment penalty = 200 ST remaining

