version: '3.8'

services:
  # 🏢 Central 22Hz Tick-Rate Server & Game Engine Core
  game-server:
    build: .
    environment:
      - NODE_ENV=production
      - PORT=3000
      - MONGO_URI=mongodb://mongodb-container:27017/archverse
      - REDIS_URI=redis://redis-cache-container:6379
    expose:
      - "3000"
    depends_on:
      - mongodb-container
      - redis-cache-container
    restart: always

  # 🗄️ In-Memory Telemetry Cache (Handles high-frequency lifestyle data bursts)
  redis-cache-container:
    image: redis:alpine
    expose:
      - "6379"
    restart: always

  # 🔒 Persistent Database Layer
  mongodb-container:
    image: mongo:latest
    volumes:
      - archverse_db_data:/data/db
    expose:
      - "27017"
    restart: always

  # 🛡️ WSS/HTTPS Reverse Proxy & Anonymous Strict Firewall Layer
  nginx-proxy:
    image: nginx:alpine
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./certs:/etc/nginx/certs:ro
    depends_on:
      - game-server
    restart: always

volumes:
  archverse_db_data:
