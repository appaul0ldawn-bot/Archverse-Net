import React, { useState, useEffect } from 'react';

export function AuraScannerHUD({ currentUser, socket }) {
  const [telemetry, setTelemetry] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);

  useEffect(() => {
    socket.emit('request_aura_analytics_snapshot', { username: currentUser.name });
    socket.on('aura_analytics_payload', (data) => {
      setTelemetry(data);
    });
    return () => socket.off('aura_analytics_payload');
  }, [currentUser, socket]);

  const triggerRecompilePatterns = () => {
    setIsProcessing(true);
    // Request server to pull fitness app and dream journal updates instantly
    socket.emit('force_recompile_behavioral_patterns', { username: currentUser.name });
    setTimeout(() => setIsProcessing(false), 1500);
  };

  return (
    <div className="storefront-overlay-wrapper" style={{ top: '15%', left: '24px', width: '350px', borderColor: '#10b981' }}>
      <div className="store-header">
        <h3 style={{ margin: 0, color: '#10b981' }}>👁️ Sentient Aura & Mood Monitor</h3>
      </div>

      <p style={{ fontSize: '11px', color: '#94a3b8', margin: '4px 0 12px 0', textAlign: 'left' }}>
        Learns behavioral patterns, schedules, and sleep quality across your devices. Computes real-time WebGL aura shader color states.
      </p>

      {telemetry ? (
        <div style={{ textAlign: 'left', display: 'flex', flexDirection: 'column', gap: '8px', fontSize: '12px' }}>
          <div style={{ background: 'rgba(0,0,0,0.4)', padding: '10px', borderRadius: '8px', border: `1px solid ${telemetry.color}` }}>
            <div className="metric-row">
              <span>🌟 Aura Color State:</span>
              <span style={{ color: telemetry.color, fontWeight: 'bold' }}>{telemetry.stateTag}</span>
            </div>
            <div style={{ width: '100%', height: '6px', borderRadius: '3px', backgroundColor: telemetry.color, marginTop: '6px', boxShadow: `0 0 10px ${telemetry.color}` }} />
          </div>

          <div className="dashboard-section-title">Pattern Matrix Intelligence</div>
          <div className="metric-row"><span>Sleep Evaluation:</span><span>{telemetry.sleepHours} hrs/night</span></div>
          <div className="metric-row"><span>Aether Sentiment Score:</span><span>{telemetry.sentiment >= 0 ? `+${telemetry.sentiment}` : telemetry.sentiment}</span></div>
          
          <div style={{ borderTop: '1px solid rgba(255,255,255,0.05)', paddingTop: '8px', marginTop: '4px' }}>
            <span style={{ fontSize: '10px', color: '#a5b4fc', display: 'block', fontWeight: 'bold' }}>🎯 DIRECTIVE INSPIRATION:</span>
            <div style={{ color: '#fff', fontSize: '11px', fontWeight: 'bold', margin: '2px 0' }}>Recommended Guild: {telemetry.guild}</div>
            <button 
              onClick={() => socket.emit('claim_inspired_contract', { missionId: telemetry.missionTarget, username: currentUser.name })}
              className="buy-upgrade-btn" style={{ width: '100%', marginTop: '6px', background: telemetry.color, color: '#0f172a', fontWeight: 'bold' }}
            >
              🚀 Claim Inspired Mission Contract
            </button>
          </div>
        </div>
      ) : (
        <div style={{ fontSize: '11px', color: '#64748b' }}>Parsing cross-device routine memory drives...</div>
      )}

      <button onClick={triggerRecompilePatterns} disabled={isProcessing} className="dashboard-toggle-btn" style={{ width: '100%', marginTop: '10px' }}>
        {isProcessing ? '🔄 Synchronizing Biometrics...' : '🔄 Force Re-Sync Device Patterns'}
      </button>
    </div>
  );
}
