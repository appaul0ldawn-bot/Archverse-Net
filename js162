const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file

describe('Archverse Celestial Voice Selection Matrix Integrity', () => {

  it('should accurately resolve British-English en-GB culture parameters when evaluating a Pleiadian NPC node', () => {
    const { determineVoiceProfile } = require('./voiceMatrix');
    
    const mockNpc = {
      npcId: 'npc_test_77',
      name: 'Watcher_Ananias',
      cosmicRace: 'Pleiadian'
    };

    const calculatedVoice = determineVoiceProfile(mockNpc);
    
    // Assert structural linguistic formatting match
    expect(calculatedVoice.langCultureCode).toBe('en-GB');
    expect(calculatedVoice.vocalPitch).toBe(1.1);
  });

  it('should fallback cleanly to standard US parameters if an unindexed custom cosmic race string is passed', () => {
    const { determineVoiceProfile } = require('./voiceMatrix');
    
    const anomalousNpc = {
      npcId: 'npc_anomaly',
      name: 'UnknownEntity',
      cosmicRace: 'UnregisteredVoidRace'
    };

    const fallbackVoice = determineVoiceProfile(anomalousNpc);
    expect(fallbackVoice.langCultureCode).toBe('en-US');
    expect(fallbackVoice.vocalPitch).toBe(1.0);
  });
});
