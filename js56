// 🌌 INSTANT VOID INGESTION GATEWAY (FALL THROUGH GAP OR FREEZE TRIGGER)
// ==========================================================================
router.post('/api/void/trigger-ingestion', async (req, res) => {
  try {
    const { username, currentX, currentZ } = req.body;
    const user = await User.findOne({ username });

    if (!user) return res.status(404).json({ success: false, error: 'User proxy profile invalid.' });

    let voidRecord = await VoidRecovery.findOne({ userId: user._id });
    if (!voidRecord) voidRecord = new VoidRecovery({ userId: user._id, username });

    // Cache position prior to warp isolation
    voidRecord.isTrappedInVoidNode = true;
    voidRecord.previousSafeCoordinates = { x: currentX, z: currentZ };
    voidRecord.soulContractAcceptedStatus = false;
    await voidRecord.save();

    user.activeVisualState = 'VOID_BACKROOM_SHROUD'; // Programmatically applies zero-light black shader
    await user.save();

    res.json({
      success: true,
      currentStatus: "VOID_BACKROOM_CONTAINMENT",
      message: "⏳ System Alert: Critical map gap fall-through or engine freeze detected. Container isolated to The Place Where Nobody Goes."
    });
  } catch (err) {
    res.status(500).json({ success: false, error: 'Void ingestion calculation failure.' });
  }
});

