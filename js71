const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file
const User = require('./models/User');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
  
  // Initialize Arcade schemas inside testing memory sandbox
  mongoose.model('CelestialArcadeMatch', new mongoose.Schema({
    matchId: String,
    gameType: String,
    activePlayerUserIds: [mongoose.Schema.Types.ObjectId],
    tokenPotST: Number,
    gameSessionData: { vowelFreeWordLedger: [String] },
    matchStatus: String
  }));
});

afterEach(async () => {
  await User.deleteMany({});
  if (mongoose.modelNames().includes('CelestialArcadeMatch')) {
    await mongoose.model('CelestialArcadeMatch').deleteMany({});
  }
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

// ==========================================================================
// 👼 SUITE 33: CELESTIAL ARCADE LINGUISTIC & INTERCEPTION PIPELINE GATES
// ==========================================================================
describe('Archverse Celestial Arcade Game Metric Evaluators', () => {

  it('should reject word submissions containing vowels inside the Alpha-Omega Word Challenge', async () => {
    await User.create({ username: 'LinguisticScholar', tokens: 100 });

    await mongoose.model('CelestialArcadeMatch').create({
      matchId: "match_arcade_111",
      gameType: "ALPHA_OMEGA_WORD_CHALLENGE",
      gameSessionData: { vowelFreeWordLedger: [] },
      matchStatus: 'ACTIVE_PLAY'
    });

    const response = await request(app)
      .post('/api/arcade/process-action')
      .send({
        matchId: 'match_arcade_111',
        username: 'LinguisticScholar',
        targetGameType: 'ALPHA_OMEGA_WORD_CHALLENGE',
        actionPayloadString: 'ANGEL' // Contains invalid vowels 'A' and 'E'
      });

    expect(response.status).toBe(400); // Intercepted safely by the vowel-free dictionary guardrail
    expect(response.body.success).toBe(false);
    expect(response.body.error).toContain('The Letter Kills');
  });

  it('should accept valid consonant lightcode arrays and increase player token balances', async () => {
    await User.create({ username: 'LightcodeSeer', tokens: 100 });

    const response = await request(app)
      .post('/api/arcade/process-action')
      .send({
        matchId: 'match_arcade_111',
        username: 'LightcodeSeer',
        targetGameType: 'ALPHA_OMEGA_WORD_CHALLENGE',
        actionPayloadString: 'YHWH' // Purely consonants
      });

    expect(response.status).toBe(200);
    expect(response.body.success).toBe(true);
    expect(response.body.playerUtilityTokensBalance).toBe(250); // 100 starting + 150 success reward = 250 ST total
  });
});
