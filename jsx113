import React, { useState } from 'react';

export function ProtectionForgeHUD({ currentUsername }) {
  const [offenderEmail, setOffenderEmail] = useState('');
  const [radius, setRadius] = useState(100);
  const [statusMessage, setStatusMessage] = useState('');

  const handleFileProtectionSeal = async () => {
    if (!offenderEmail.trim()) return;

    try {
      const response = await fetch('/api/protection/file-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          requestorUsername: currentUsername,
          targetOffenderEmail: offenderEmail.trim(),
          customRadiusMeters: radius
        })
      });
      const data = await response.json();
      if (data.success) {
        setStatusMessage(data.message);
        setOffenderEmail('');
      }
    } catch (e) {
      console.error("Failed to compile protection seal handshake:", e);
    }
  };

  return (
    <div className="storefront-overlay-wrapper" style={{ top: '55%', left: '1130px', width: '350px', borderColor: '#ef4444' }}>
      <div className="store-header">
        <h3 style={{ margin: 0, color: '#f87171', fontFamily: 'serif' }}>🛡️ Protection Covenant Forge</h3>
      </div>

      <p style={{ fontSize: '11px', color: '#94a3b8', margin: '4px 0 12px 0', textAlign: 'left' }}>
        File spiritual restraining orders and coordinate geofenced defensive rings to intercept unaligned nodes, tracking handlers, or bad actors.
      </p>

      <div style={{ display: 'flex', flexDirection: 'column', gap: '8px', marginBottom: '10px', textAlign: 'left' }}>
        <label style={{ fontSize: '10px', color: '#cbd5e1' }}>Target Offender Email / Identifier:</label>
        <input type="text" value={offenderEmail} onChange={(e) => setOffenderEmail(e.target.value)} placeholder="e.g., offender@unaligned.net" style={{ background: 'rgba(0,0,0,0.4)', padding: '8px', color: '#fff', borderRadius: '6px', border: '1px solid rgba(255,255,255,0.1)', fontSize: '12px' }} />
        
        <div className="metric-row" style={{ marginTop: '4px' }}>
          <span style={{ fontSize: '11px' }}>Geofence Radius:</span>
          <input type="range" min="50" max="500" step="50" value={radius} onChange={(e) => setRadius(parseInt(e.target.value))} style={{ width: '120px', accentColor: '#ef4444' }} />
          <span style={{ fontSize: '11px', fontWeight: 'bold' }}>{radius}m</span>
        </div>
      </div>

      <button onClick={handleFileProtectionSeal} className="buy-upgrade-btn" style={{ width: '100%', background: '#dc2626', color: '#fff', fontWeight: 'bold' }}>
        🔒 Deploy Spiritual Restraining Order
      </button>

      {statusMessage && (
        <div style={{ marginTop: '10px', background: 'rgba(239,68,68,0.06)', border: '1px solid #ef4444', padding: '8px', borderRadius: '6px', fontSize: '11px', textAlign: 'left', color: '#fca5a5' }}>
          {statusMessage}
        </div>
      )}
    </div>
  );
}
