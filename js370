import React, { useState } from 'react';

export function AdminXrayControlHUD({ adminEmail, selectedPlayerName, socket }) {
  const [xrayEnabled, setXrayEnabled] = useState(false);

  const toggleXrayMod = async () => {
    const nextState = !xrayEnabled;
    setXrayEnabled(nextState);

    try {
      await fetch('/api/admin/toggle-xray-vision', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          adminEmail: adminEmail,
          targetUsername: selectedPlayerName,
          toggleState: nextState
        })
      });
    } catch (e) {
      console.error("X-Ray module transmission failure", e);
    }
  };

  return (
    <div className="chat-log-sidebar" style={{ top: '78%', right: '24px', width: '250px', borderColor: '#eab308' }}>
      <div style={{ fontSize: '11px', color: '#eab308', fontWeight: 700, marginBottom: '6px' }}>
        👁️ MASTER MOD: EYES OF SUPERMAN
      </div>
      
      <button 
        onClick={toggleXrayMod}
        className="buy-upgrade-btn" 
        style={{ width: '100%', background: xrayEnabled ? '#ef4444' : '#eab308', color: xrayEnabled ? '#fff' : '#0f172a' }}
      >
        {xrayEnabled ? '🛑 Deactivate X-Ray Vision' : '⚡ Activate X-Ray Vision'}
      </button>

      {xrayEnabled && (
        <div style={{ marginTop: '8px', fontSize: '10px', color: '#94a3b8', textAlign: 'left', lineHeight: 1.3 }}>
          🧬 <em>Scanning character base metadata...</em>
          {"\n"}• Target Node: {selectedPlayerName || 'None Selected'}
          {"\n"}• Mapping base mesh parameters from scratch...
        </div>
      )}
    </div>
  );
}
