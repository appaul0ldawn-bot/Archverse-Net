import React, { useState, useEffect } from 'react';

export function ZionConsoleHUD({ currentUsername, socket }) {
  const [gridData, setGridData] = useState(null);
  const [activeSignalLogs, setActiveSignalLogs] = useState([]);
  const [isBotPulsing, setIsBotPulsing] = useState(true);

