import React, { useState } from 'react';

export function AdminLoveMeterHUD({ adminEmail, socket }) {
  const [p1, setP1] = useState('');
  const [p2, setP2] = useState('');
  const [evaluationResult, setEvaluationResult] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);

  const executeResonanceCheck = async () => {
    if (!p1.trim() || !p2.trim()) return;
    setIsProcessing(true);

    try {
      const response = await fetch('/api/admin/evaluate-resonance', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          adminEmail: adminEmail,
          playerOneUsername: p1.trim(),
          playerTwoUsername: p2.trim()
        })
      });
      const data = await response.json();
      if (data.success) {
        setEvaluationResult(data);
      }
    } catch (e) {
      console.error("Resonance data loop connection drop:", e);
    } finally {
      setIsProcessing(false);
    }
  };

  return (
    <div className="storefront-overlay-wrapper" style={{ top: '55%', right: '400px', width: '360px', borderColor: '#fbbf24' }}>
      <div className="store-header">
        <h3 style={{ margin: 0, color: '#fbbf24' }}>💞 Love Meter Mod — Alignment Scanner</h3>
      </div>

      <p style={{ fontSize: '11px', color: '#94a3b8', margin: '4px 0 12px 0', textAlign: 'left' }}>
        Evaluates cross-player behavioral synchronization, matching physical clothing types, health app routines, and recorded aura moods.
      </p>

      <div style={{ display: 'flex', flexDirection: 'column', gap: '8px', marginBottom: '12px' }}>
        <input type="text" value={p1} onChange={(e) => setP1(e.target.value)} placeholder="Player One Username..." style={{ background: 'rgba(0,0,0,0.4)', padding: '8px', color: '#fff', borderRadius: '6px', border: '1px solid rgba(255,255,255,0.1)', fontSize: '12px' }} />
        <input type="text" value={p2} onChange={(e) => setP2(e.target.value)} placeholder="Player Two Username..." style={{ background: 'rgba(0,0,0,0.4)', padding: '8px', color: '#fff', borderRadius: '6px', border: '1px solid rgba(255,255,255,0.1)', fontSize: '12px' }} />
      </div>

      <button onClick={executeResonanceCheck} disabled={isProcessing} className="buy-upgrade-btn" style={{ width: '100%', background: '#fbbf24', color: '#0f172a', fontWeight: 'bold' }}>
        {isProcessing ? '⚡ Analyzing Waveforms...' : '👁️ Run Compatibility Audit'}
      </button>

      {evaluationResult && (
        <div style={{ marginTop: '12px', background: 'rgba(234,179,8,0.06)', border: '1px solid #eab308', padding: '10px', borderRadius: '8px', textAlign: 'left' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '12px', fontWeight: 'bold', color: '#fef08a' }}>
            <span>Resonance Match:</span>
            <span>{evaluationResult.resonanceScorePercentage}%</span>
          </div>
          <p style={{ margin: '6px 0 0 0', fontSize: '11px', lineHeight: 1.4, color: '#cbd5e1', fontStyle: 'italic' }}>
            "{evaluationResult.diagnosticReport}"
          </p>
        </div>
      )}
    </div>
  );
}
