const express = require('express');
const router = express.Router();
const mongoose = require('mongoose');
const User = require('./models/User');

// ==========================================================================
// 🌌 THE ARCHVERSE SUPERNATURAL GEOSPATIAL REGISTRY SCHEMA
// ==========================================================================
const SupernaturalAnomalySchema = new mongoose.Schema({
  anomalyId: { type: String, required: true, unique: true, index: true },
  title: { type: String, required: true },
  category: { 
    type: String, 
    enum: ['GHOST_SIGHTING', 'HAUNTED_LOCATION', 'CRYPTID_TRACKER', 'PARANORMAL_ACTIVITY', 'ANGEL_ENCOUNTER'],
    required: true 
  },
  coordinates: {
    lat: { type: Number, required: true },
    lng: { type: Number, required: true }
  },
  sourceProvenance: String, // e.g., 'Cryptids Near Me API', 'Akashic Records Database', 'Local Witness Feed'
  vibrationalSignature: {
    frequencyHz: Number,    // e.g., 396Hz for entities, 963Hz for Angel nodes
    particleGlowColor: String
  },
  reportedAt: { type: Date, default: Date.now }
});

const AnomalyNode = mongoose.model('SupernaturalAnomaly', SupernaturalAnomalySchema);

// Daily Automated Sync Ingestion Pipeline Entry Point
router.post('/api/anomaly/daily-sync', async (req, res) => {
  try {
    const { syncPassphrase, inboundManifestData } = req.body;
    
    // Master administrative token firewall signature check
    if (syncPassphrase !== process.env.ADMIN_JWT_SECRET && syncPassphrase !== "SECRET_HEAVEN_KEY_999") {
      return res.status(403).json({ success: false, error: 'Unauthorized data injection vector detected.' });
    }

    let logsCommitted = 0;
    for (const anomaly of inboundManifestData) {
      await AnomalyNode.findOneAndUpdate(
        { anomalyId: anomaly.anomalyId },
        anomaly,
        { upsert: true, new: true }
      );
      logsCommitted++;
    }

    global.stateHasChanged = true; // Signal central 22Hz tick engines to reload local map viewports
    res.json({ success: true, message: `Successfully synchronized ${logsCommitted} multi-source anomalies down the pipeline.` });
  } catch (err) {
    res.status(500).json({ success: false, error: 'Daily anomaly sync pipeline exception.' });
  }
});

module.exports = router;
