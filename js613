import React from 'react';

const ECOSYSTEM_LINKS = [
  { platform: 'Discord', name: '🔊 Council Room', url: 'https://discord.gg', color: '#5865F2' },
  { platform: 'Telegram', name: '✈️ Watchers Channel', url: 'https://t.me', color: '#26A5E4' },
  { platform: 'GitHub', name: '💻 Source Matrix', url: 'https://github.com', color: '#24292F' },
  { platform: 'Facebook', name: '👥 Millennial Reign Guild', url: 'https://facebook.com', color: '#1877F2' }
];

export function CrossPlatformIntegrationsHUD({ userTokens, userPsychology }) {
  
  const handleShareMetrics = () => {
    const shareText = `✨ I have manifested the rank of Seraph Knight inside the Archverse! Current Balance: 🪙 ${userTokens} ST. Track the Millennial Reign timeline with me here: https://yourdomain.com`;
    const facebookShareUrl = `https://facebook.com{encodeURIComponent('https://yourdomain.com')}&quote=${encodeURIComponent(shareText)}`;
    window.open(facebookShareUrl, '_blank', 'width=600,height=400');
  };

  return (
    <div className="chat-log-sidebar" style={{ top: '12%', left: 'auto', right: '24px', width: '250px', maxHeight: '35%' }}>
      <div style={{ fontSize: '11px', color: '#a5b4fc', fontWeight: 700, letterSpacing: '0.05em', marginBottom: '8px' }}>
        🔗 MULTIVERSE ECOSYSTEM BRIDGES
      </div>

      {/* External Community Links Row Buttons */}
      <div style={{ display: 'flex', flexDirection: 'column', gap: '6px', marginBottom: '12px' }}>
        {ECOSYSTEM_LINKS.map((link) => (
          <a
            key={link.platform}
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            style={{
              display: 'flex', alignItems: 'center', justifyContent: 'space-between',
              background: 'rgba(255,255,255,0.03)', border: `1px solid ${link.color}44`,
              padding: '8px 12px', borderRadius: '8px', color: '#fff', textDecoration: 'none',
              fontSize: '12px', fontWeight: '600', transition: 'all 0.15s ease'
            }}
            onMouseEnter={(e) => e.currentTarget.style.background = `${link.color}22`}
            onMouseLeave={(e) => e.currentTarget.style.background = 'rgba(255,255,255,0.03)'}
          >
            <span>{link.name}</span>
            <span style={{ fontSize: '10px', color: link.color, fontWeight: 'bold' }}>{link.platform.toUpperCase()}</span>
          </a>
        ))}
      </div>

      {/* Direct Facebook Share Ingestion Trigger */}
      <button 
        onClick={handleShareMetrics}
        className="buy-upgrade-btn" 
        style={{ width: '100%', background: 'linear-gradient(to right, #4f46e5, #1877f2)', fontSize: '11px' }}
      >
        📢 Broadcast Matrix Standing to Facebook
      </button>

      {userPsychology && (
        <div style={{ marginTop: '8px', fontSize: '10px', color: '#94a3b8', textAlign: 'center', fontStyle: 'italic' }}>
          Resonance Tracking: {userPsychology.movementCadence || 'Calibrating Core'}
        </div>
      )}
    </div>
  );
}
