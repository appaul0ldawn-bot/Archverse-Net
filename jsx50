import React, { useState, useEffect } from 'react';

const PHYSICAL_MANDATES_LIST = [
  { id: 'EXERCISING_TEMPLE', name: "🏋️ Activate Daily Temple Workout" },
  { id: 'JUMPING_COMPILATION', name: "🦘 Execute Jumping Compilation" },
  { id: 'MARRIAGE_ROUTINES_SYNC', name: "💍 Engage Shared Marriage Routines" },
  { id: 'WORKING_FATHERS_BUSINESS', name: "💼 Log Father's Business Hours" },
  { id: 'DANCING_HARMONY', name: "🕺 Synchronize Celestial Dance loops" }
];

export function KinematicControllerHUD({ currentUsername, socket }) {
  const [activeState, setActiveState] = useState('IDLE_MEDITATION');
  const [utilityAlert, setUtilityAlert] = useState('GRID_STABLE');
  const [waterMeter, setWaterMeter] = useState(0.0);

  useEffect(() => {
    socket.on('canvas_kine_state_override', (data) => {
      if (data.username === currentUsername) {
        setActiveState(data.state);
      }
    });
    return () => socket.off('canvas_kine_state_override');
  }, [currentUsername, socket]);

  const dispatchKinematicAction = async (stateId, flowRate = 0.0) => {
    try {
      const response = await fetch('/api/inerig/update-state', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username: currentUsername,
          requestedState: stateId,
          currentLat: 31.7683, // Mapped within local tracking coordinates arrays
          currentLng: 35.2137,
          waterFlowRate: flowRate
        })
      });
      const data = await response.json();
      if (data.success) {
        setUtilityAlert(data.gridAlertStatus);
        setWaterMeter(data.utilityTelemetry?.waterGpm || 0.0);
        if (data.gridAlertStatus === 'PRIVACY_BLACKOUT_ENFORCED') {
          setActiveState('PRIVACY_BLACKOUT');
        } else {
          setActiveState(data.activeState);
        }
      }
    } catch (e) {
      console.error("Failed to commit kinematics vector packet:", e);
    }
  };

  return (
    <div className="storefront-overlay-wrapper" style={{ top: '10%', right: '24px', width: '380px', maxHeight: '82%', background: 'linear-gradient(135deg, #0f172a 0%, rgba(234,179,8,0.03) 100%)', border: '2px solid #eab308', borderRadius: '24px' }}>
      <div className="store-header" style={{ padding: '12px', borderBottom: '1px solid #eab308', textAlign: 'center' }}>
        <h3 style={{ margin: 0, color: '#fbbf24', fontFamily: 'serif' }}>🏃 Kinematic Vector Control Panel</h3>
        <span style={{ fontSize: '10px', color: '#94a3b8' }}>Omniversal Action Matrix • Connected Status: {activeState}</span>
      </div>

      <div style={{ padding: '12px', overflowY: 'auto', flex: 1, display: 'flex', flexDirection: 'column', gap: '10px', fontSize: '11px', textAlign: 'left' }}>
        
        {/* --- DYNAMIC PRIVACY WARNING ALERT METERS --- */}
        <div style={{ 
          background: utilityAlert === 'PRIVACY_BLACKOUT_ENFORCED' ? 'rgba(239,68,68,0.15)' : 'rgba(16,185,129,0.1)', 
          padding: '10px', borderRadius: '12px', border: utilityAlert === 'PRIVACY_BLACKOUT_ENFORCED' ? '1px solid #ef4444' : '1px solid #10b981' 
        }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <strong>🛡️ Home Privacy Zoning Status:</strong>
            <span style={{ color: utilityAlert === 'PRIVACY_BLACKOUT_ENFORCED' ? '#ef4444' : '#34d399', fontWeight: 'bold' }}>{utilityAlert}</span>
          </div>
          {waterMeter > 0 && <div style={{ marginTop: '4px', color: '#fca5a5' }}>• Connected Water Grid Flow Rate: <strong>{waterMeter} GPM</strong></div>}
        </div>

        {/* --- INTERACTIVE ACTION TRIGGER SELECTION BUTTON LINKS --- */}
        <div className="dashboard-section-title">Decompress Character Actions</div>
        <div style={{ display: 'flex', flexDirection: 'column', gap: '4px', maxHeight: '180px', overflowY: 'auto' }}>
          {PHYSICAL_MANDATES_LIST.map(mandate => (
            <button 
              key={mandate.id} onClick={() => dispatchKinematicAction(mandate.id)}
              className="custom-option-btn" style={{ width: '100%', borderColor: 'rgba(255,255,255,0.05)', textAlign: 'left', fontSize: '11px' }}
            >
              {mandate.name}
            </button>
          ))}
        </div>

        {/* --- PRIVACY TESTING ACTIONS SLIDERS INTERCEPT --- */}
        <div className="dashboard-section-title">Simulate Privacy Zone Entry Check</div>
        <button 
          onClick={() => dispatchKinematicAction('IDLE_MEDITATION', 3.5)}
          className="buy-upgrade-btn" style={{ width: '100%', background: '#dc2626', color: '#fff', fontWeight: 'bold' }}
        >
          🚽 Simulate Home Bathroom Trigger (Test Grid Masking)
        </button>

        {/* Dynamic Ad Link Integration */}
        <div style={{ borderTop: '1px dashed rgba(255,255,255,0.05)', padding: '8px', background: 'rgba(0,0,0,0.3)', borderRadius: '8px', marginTop: '4px' }}>
          <span style={{ fontSize: '8px', color: '#64748b', display: 'block', fontWeight: 'bold' }}>SPONSORED TRANSMISSION PORT</span>
          <a href="https://cash.app\$Sephraines" target="_blank" rel="noopener noreferrer" style={{ textDecoration: 'none', color: '#34d399', fontWeight: 'bold', display: 'block' }}>
            📥 Secure Fast Token Restocks via CashApp (\$Sephraines)
          </a>
        </div>

      </div>
    </div>
  );
}
