import React, { useRef } from 'react';
import { useFrame } from '@react-three/fiber';
import { Html } from '@react-three/drei';

export function PrivateSanctuaryBoundary({ centerPos, scale =, allowedUsersList, localPlayerName }) {
  const boundaryMeshRef = useRef();
  
  // Vampiric Access Enforcement Rule
  const hasAccessPermission = allowedUsersList.includes(localPlayerName);

  useFrame((state) => {
    if (!boundaryMeshRef.current) return;
    const time = state.clock.getElapsedTime();
    
    // Slow breathing warning ripple animation for unauthorized entities
    boundaryMeshRef.current.material.opacity = hasAccessPermission ? 0.05 : 0.25 + Math.sin(time * 4) * 0.08;
  });

  return (
    <group position={centerPos}>
      {/* Visual Bounding Cube representing home structure boundaries */}
      <mesh ref={boundaryMeshRef} castShadow={false} receiveShadow={false}>
        <boxGeometry args={scale} />
        <meshStandardMaterial 
          color={hasAccessPermission ? "#34d399" : "#ef4444"} 
          transparent 
          opacity={0.2}
          wireframe={!hasAccessPermission}
        />
      </mesh>

      {/* Threshold Warning Label HUD */}
      {!hasAccessPermission && (
        <Html position={[0, scale / 2 + 0.5, 0]} center distanceFactor={8}>
          <div style={{
            background: 'rgba(15, 23, 42, 0.95)', border: '1.5px solid #ef4444',
            padding: '6px 12px', borderRadius: '8px', color: '#fca5a5',
            fontFamily: 'sans-serif', fontSize: '11px', whiteSpace: 'nowrap'
          }}>
            🔒 Threshold Locked: Must be invited to cross.
          </div>
        </Html>
      )}
    </group>
  );
}
