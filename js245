import React, { useState, useEffect, useRef } from 'react';
import { useFrame } from '@react-three/fiber';
import { Html } from '@react-three/drei';
import * as THREE from 'three';

export function SupernaturalMapLayers({ socket, currentLat, currentLng }) {
  const [anomalies, setAnomalies] = useState([]);
  const [selectedAnomaly, setSelectedAnomaly] = useState(null);
  const meshGroupRef = useRef();

  useEffect(() => {
    // Intercept automated 24-hour synchronized tracking updates fired by server tickers
    socket.emit('request_daily_anomalies');
    socket.on('anomaly_matrix_payload', (data) => {
      setAnomalies(data);
    });
    return () => socket.off('anomaly_matrix_payload');
  }, [socket]);

  useFrame((state) => {
    if (!meshGroupRef.current) return;
    const time = state.clock.getElapsedTime();

    // Loop through individual floating elements to render breathing, non-linear distortion pulses
    meshGroupRef.current.children.forEach((mesh, idx) => {
      const pulsationScale = 1.0 + Math.sin(time * 2.0 + idx) * 0.08;
      mesh.scale.set(pulsationScale, pulsationScale, pulsationScale);
      mesh.rotation.y = time * 0.3 + idx;
    });
  });

  const getAnomalyVisuals = (category) => {
    switch (category) {
      case 'ANGEL_ENCOUNTER':     return { color: '#fde047', emissive: '#fbbf24', geometry: 'tetrahedron' }; // Pure Golden Fire
      case 'GHOST_SIGHTING':      return { color: '#94a3b8', emissive: '#cbd5e1', geometry: 'dodecahedron' }; // Translucent Ghost Echos
      case 'CRYPTID_TRACKER':     return { color: '#22c55e', emissive: '#15803d', geometry: 'octahedron' }; // Cryptids Near Me emerald tracking glow
      case 'HAUNTED_LOCATION':    return { color: '#ef4444', emissive: '#b91c1c', geometry: 'box' }; // High-risk red structural boundary
      default:                    return { color: '#a855f7', emissive: '#7e22ce', geometry: 'sphere' };
    }
  };

  return (
    <group ref={meshGroupRef}>
      {anomalies.map((node, index) => {
        const visuals = getAnomalyVisuals(node.category);
        
        // Translate geographical GPS coordinates cleanly into local 3D workspace vector planes
        const localX = (node.coordinates.lat - currentLat) * 111000;
        const localZ = (node.coordinates.lng - currentLng) * 111000;

        return (
          <mesh 
            key={node.anomalyId} 
            position={[localX, 1.5, localZ]}
            onClick={() => setSelectedAnomaly(node)}
          >
            {visuals.geometry === 'tetrahedron' && <tetrahedronGeometry args={[0.3, 0]} />}
            {visuals.geometry === 'dodecahedron' && <dodecahedronGeometry args={[0.3, 0]} />}
            {visuals.geometry === 'octahedron' && <octahedronGeometry args={[0.3, 0]} />}
            {visuals.geometry === 'box' && <boxGeometry args={[0.4, 0.4, 0.4]} />}
            
            <meshStandardMaterial 
              color={visuals.color} 
              emissive={visuals.emissive} 
              emissiveIntensity={2.5} 
              wireframe={node.category !== 'ANGEL_ENCOUNTER'} 
              transparent 
              opacity={0.7} 
            />

            {/* Bounding Text Content Box HUD */}
            {selectedAnomaly?.anomalyId === node.anomalyId && (
              <Html center position={[0, 0.6, 0]} distanceFactor={8}>
                <div style={{
                  background: 'rgba(15,23,42,0.95)', border: `1.5px solid ${visuals.color}`,
                  borderRadius: '10px', padding: '10px 14px', color: '#fff', fontSize: '11px',
                  width: '240px', boxShadow: '0 10px 25px rgba(0,0,0,0.5)', fontFamily: 'sans-serif'
                }}>
                  <strong style={{ color: visuals.color, display: 'block' }}>👾 {node.title}</strong>
                  <span style={{ fontSize: '9px', color: '#94a3b8', display: 'block', margin: '2px 0' }}>Source: {node.sourceProvenance}</span>
                  <div style={{ fontSize: '10px', marginTop: '4px', borderTop: '1px solid rgba(255,255,255,0.05)', paddingTop: '4px', color: '#cbd5e1' }}>
                    Resonance: {node.vibrationalSignature.frequencyHz}Hz Channel
                  </div>
                  <button onClick={(e) => { e.stopPropagation(); setSelectedAnomaly(null); }} className="buy-upgrade-btn" style={{ padding: '2px 6px', marginTop: '6px', fontSize: '9px', width: '100%' }}>✕ Close Window</button>
                </div>
              </Html>
            )}
          </mesh>
        );
      })}
    </group>
  );
}
