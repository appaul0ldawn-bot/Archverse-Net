import React, { useState, useEffect } from 'react';

export function OphansOverlookHUD({ currentUsername, socket }) {
  const [mercyLog, setMercyLog] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);

  useEffect(() => {
    socket.emit('request_ophans_overlook_telemetry', { username: currentUsername });
    socket.on('orphans_overlook_payload', (data) => {
      setMercyLog(data);
    });
    return () => socket.off('orphans_overlook_payload');
  }, [currentUsername, socket]);

  const triggerAcousticMercyAudit = async () => {
    setIsProcessing(true);
    try {
      const response = await fetch('/api/judicial/apply-ophans-overlook', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username: currentUsername,
          rawFrictionIntensityScore: 24 // Simulates a standard minor daily friction infraction
        })
      });
      const data = await response.json();
      if (data.success) {
        setMercyLog(data);
      }
    } catch (e) {
      console.error("Failed to connect with the mercy mitigation matrix:", e);
    } finally {
      setIsProcessing(false);
    }
  };

  return (
    <div className="storefront-overlay-wrapper" style={{
      top: '12%', right: '24px', width: '360px', maxHeight: '82%',
      background: 'linear-gradient(135deg, rgba(15,23,42,0.98) 0%, rgba(16,185,129,0.03) 100%)', // Emerald Deep Shroud
      border: '2px solid #10b981', borderRadius: '24px', boxShadow: '0 0 25px rgba(16,185,129,0.15)'
    }}>
      <div className="store-header" style={{ borderColor: 'rgba(16,185,129,0.2)', paddingBottom: '10px' }}>
        <h3 style={{ margin: 0, color: '#34d399', fontFamily: 'serif', letterSpacing: '0.04em' }}>🕊️ Ophan’s Overlook HUD</h3>
        <span style={{ fontSize: '9px', color: '#94a3b8' }}>Automated Grace Filter • Virtues Hierarchy Oversight</span>
      </div>

      <div style={{ padding: '12px', display: 'flex', flexDirection: 'column', gap: '10px', fontSize: '11px', textAlign: 'left' }}>
        
        {/* --- DYNAMIC GRACE MULTIPLIER DATA CARD --- */}
        {mercyLog ? (
          <div style={{ background: 'rgba(0,0,0,0.4)', padding: '12px', borderRadius: '12px', border: '1px solid rgba(16,185,129,0.1)' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span>🛡️ Compassion Core Status:</span>
              <strong style={{ color: '#34d399', textShadow: '0 0 4px #10b981' }}>
                {mercyLog.overlookAuditStatus || 'HARMONIC_MERCY_ENGAGED'}
              </strong>
            </div>

            {/* Visual Grace Distribution Progress Bar */}
            <div style={{ width: '100%', height: '4px', background: '#334155', borderRadius: '2px', marginTop: '8px', position: 'relative' }}>
              <div style={{ 
                position: 'absolute', 
                left: `${Math.min(100, (mercyLog.mitigationMetrics?.totalOverlookedAnomalies || 1) * 15)}%`, 
                top: '-4px', width: '12px', height: '12px', borderRadius: '50%', 
                background: '#34d399', boxShadow: '0 0 8px #10b981' 
              }} />
            </div>

            <div style={{ display: 'flex', flexDirection: 'column', gap: '2px', fontSize: '10px', color: '#94a3b8', marginTop: '8px' }}>
              <div>• Total Minor Anomalies Let Slide: <strong style={{ color: '#fff' }}>{mercyLog.mitigationMetrics?.totalOverlookedAnomalies || 0}</strong></div>
              <div>• Compressed Friction Load Owed: <strong>{mercyLog.mitigationMetrics?.compressedFrictionFiled || 0} Points</strong></div>
            </div>
          </div>
        ) : (
          <div style={{ color: '#64748b', fontStyle: 'italic' }}>Awaiting structural grace telemetry ingestion ticks...</div>
        )}

        {/* --- REWARDS LOG BREAKDOWN --- */}
        {mercyLog?.rewardsYielded && (
          <div style={{ background: 'rgba(255,255,255,0.01)', padding: '10px', borderRadius: '8px', border: '1px solid rgba(255,255,255,0.03)' }}>
            <div className="metric-row"><span>🪙 Overlook Grace Payout:</span><strong style={{ color: '#fbbf24' }}>+{mercyLog.rewardsYielded.mercyTokensBonusPaid} Angel Tokens</strong></div>
            <div className="metric-row">
              <span>Active Aura Shield State:</span>
              <div style={{ width: '25px', height: '12px', borderRadius: '2px', backgroundColor: mercyLog.rewardsYielded.activeAuraShaderColor }} />
            </div>
          </div>
        )}

        <button 
          onClick={triggerAcousticMercyAudit} disabled={isProcessing}
          className="buy-upgrade-btn" style={{ width: '100%', background: 'linear-gradient(45deg, #047857, #10b981)', color: '#fff', fontWeight: 'bold', fontSize: '12px', padding: '10px' }}
        >
          {isProcessing ? '🔄 Clearing Minor Friction Fields...' : '🕊️ Process Overlook & Let Infraction Slide'}
        </button>

      </div>
    </div>
  );
}
