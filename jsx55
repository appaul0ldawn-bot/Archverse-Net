import React, { useState, useEffect } from 'react';

export function VoidBackroomHUD({ currentUsername, userVisualState, socket }) {
  const [isTrapped, setIsTrapped] = useState(false);
  const [isProcessing, setIsProcessing] = useState(false);

  useEffect(() => {
    if (userVisualState === 'VOID_BACKROOM_SHROUD') {
      setIsTrapped(true);
    } else {
      setIsTrapped(false);
    }
  }, [userVisualState]);

  const handleAcceptContractAndExit = async () => {
    setIsProcessing(true);
    try {
      const response = await fetch('/api/void/sign-and-exit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username: currentUsername })
      });
      const data = await response.json();
      if (data.success) {
        alert(`🏆 Grace Extended!\nMessage: "${data.popupMessage}"`);
        setIsTrapped(false);
        window.location.reload(); // Refresh viewport mesh geometry fields cleanly
      } else {
        alert(`❌ Extraction Exception: ${data.error}`);
      }
    } catch (e) {
      console.error("Failed to execute void exit portal sequence:", e);
    } finally {
      setIsProcessing(false);
    }
  };

  if (!isTrapped) return null;

  return (
    <div style={{
      position: 'fixed', top: 0, left: 0, width: '100vw', height: '100vh',
      background: '#020205', zIndex: 9999, display: 'flex', flexDirection: 'column',
      justifyContent: 'center', alignItems: 'center', fontFamily: 'monospace', color: '#fff'
    }}>
      <div style={{
        maxWidth: '420px', padding: '24px', border: '1px dashed #ef4444',
        borderRadius: '16px', background: 'rgba(0,0,0,0.8)', textAlign: 'center'
      }}>
        <h2 style={{ color: '#ef4444', margin: '0 0 10px 0', letterSpacing: '0.1em' }}>🖤 THE PLACE WHERE NOBODY GOES</h2>
        
        <div style={{ background: '#000', padding: '12px', borderRadius: '8px', fontSize: '11px', color: '#94a3b8', fontStyle: 'italic', marginBottom: '16px', border: '1px solid rgba(255,255,255,0.05)' }}>
          "Cries echo from failed timeline attempts. Alternative paths have collapsed. The container is locked inside an exitless void backroom mesh."
        </div>

        <p style={{ fontSize: '12px', color: '#cbd5e1', marginBottom: '16px', textAlign: 'left', lineHeight: 1.4 }}>
          To trigger the rescue portal and respawn back to your previous coordinates, you must renew your covenant and sign the active Soul Contract.
        </p>

        <button 
          onClick={handleAcceptContractAndExit} disabled={isProcessing}
          className="buy-upgrade-btn" style={{ width: '100%', background: '#10b981', color: '#fff', fontWeight: 'bold', padding: '12px', fontSize: '12px' }}
        >
          {isProcessing ? '🔄 Synchronizing Covenants...' : '✍️ Accept Soul Contract & Manifest Portal'}
        </button>
      </div>
    </div>
  );
}
