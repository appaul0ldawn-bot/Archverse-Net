router.post('/api/environment/sync-weather', async (req, res) => {
  try {
    const { username, currentLat, currentLng } = req.body;
    const user = await User.findOne({ username });

    if (!user) return res.status(404).json({ success: false, error: 'User coordinate node invalid.' });

    const weatherData = await fetchRealtimeWeatherCoordinates(currentLat, currentLng);
    
    // 🌌 METAPHYSICAL ENVIRONMENT MODIFIERS GATES
    let seasonalAuraOverride = "#38bdf8"; // Autumn calm cyan
    let environmentalMissionText = "Fulfill standard Lightworker grounding tasks.";

    if (weatherData.activeCondition === "METEOR_SHOWER_CLEAR_SKIES") {
      seasonalAuraOverride = "#fbbf24"; // Radiant golden shower flash
      environmentalMissionText = "🌌 [Chrono Event]: Celestial gates are open over your immediate coordinates. Step outdoor, execute a 15-minute meditation sweep, and harvest 3 spawned Monatomic Gold nodes.";
    }

    if (global.io) {
      global.io.emit('firmament_weather_render', {
        player: username,
        tintColor: seasonalAuraOverride,
        isDay: weatherData.isDaylight,
        season: weatherData.activeSeason
      });
    }

    res.json({
      success: true,
      currentForecast: weatherData,
      inspiredSeasonalMission: {
        title: "☄️ Operation: Firmament Ingestion",
        instructions: environmentalMissionText,
        rewardTokens: 300
      }
    });
  } catch (err) {
    res.status(500).json({ success: false, error: 'Chrono-weather telemetry alignment failure.' });
  }
});

module.exports = router;
