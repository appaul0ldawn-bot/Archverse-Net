const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file
const User = require('./models/User');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
  
  // Initialize Battleship schemas inside testing memory sandbox
  mongoose.model('CelestialBattleship', new mongoose.Schema({
    matchId: String,
    playerAngelicUserId: mongoose.Schema.Types.ObjectId,
    playerDemonicUserId: mongoose.Schema.Types.ObjectId,
    playerAngelicShips: [{ shipType: String, coordinatesTensor: Array, isBanishmentCollapsed: Boolean }],
    playerDemonicShips: [{ shipType: String, coordinatesTensor: Array, isBanishmentCollapsed: Boolean }],
    matchStatus: String
  }));
});

afterEach(async () => {
  await User.deleteMany({});
  if (mongoose.modelNames().includes('CelestialBattleship')) {
    await mongoose.model('CelestialBattleship').deleteMany({});
  }
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

