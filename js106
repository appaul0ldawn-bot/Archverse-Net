const express = require('express');
const router = express.Router();
const User = require('./models/User');
const AngelLottery = require('./models/AngelLottery');

// Standard English Gematria Letter-Weight Value Map Blueprints
const GEMATRIA_CIPHER = {
  a:1, b:2, c:3, d:4, e:5, f:6, g:7, h:8, i:9, j:10, k:11, l:12, m:13,
  n:14, o:15, p:16, q:17, r:18, s:19, t:20, u:21, v:22, w:23, x:24, y:25, z:26
};

function computeStringGematria(text) {
  return text.toLowerCase().split('').reduce((sum, char) => sum + (GEMATRIA_CIPHER[char] || 0), 0);
}

function calculateNumerologyReduction(number) {
  // Reduces any integer down to a single master digit (1-9) or maintains master number structures (11, 22)
  while (number > 9 && number !== 11 && number !== 22) {
    number = number.toString().split('').reduce((acc, digit) => acc + parseInt(digit), 0);
  }
  return number;
}

// ==========================================================================
// 🎰 SUBMIT UNIVERSAL LOTTERY PHRASE VECTOR ENTRY
// ==========================================================================
router.post('/api/lottery/submit-ticket', async (req, res) => {
  try {
    const { username, sacredPhraseText, activePoolId } = req.body;

    const user = await User.findOne({ username });
    const pool = await AngelLottery.findOne({ poolId: activePoolId });

    if (!user || !pool || pool.isSealedByHighCouncil) {
      return res.status(404).json({ success: false, error: 'Lottery pool closed or user node invalid.' });
    }

    // Ticket Entry token cost threshold verification (Each ticket requires 50 ST)
    if (user.tokens < 50) {
      return res.status(400).json({ success: false, error: 'Insolvent ST balance. Complete more Lightworker tasks.' });
    }

    user.tokens -= 50;
    pool.currentJackpotTokens += 50;

    // Execute Gematria and Numerological calculations
    const sum = computeStringGematria(sacredPhraseText);
    const primaryDigit = calculateNumerologyReduction(sum);

    const ticketEntry = {
      username,
      submittedPhraseString: sacredPhraseText,
      computedGematriaSum: sum,
      numerologicalReductionDigit: primaryDigit
    };

    pool.ticketEntries.push(ticketEntry);
    await pool.save();
    await user.save();

    // Trigger instant WebSocket notification if an Angel Number manifests on the canvas line
    let manifestationAlert = "Phrase registered to the firmament ledger.";
    if (sum === pool.targetAngelNumber || sum === 111 || sum === 444 || sum === 777) {
      manifestationAlert = `✨ [Angel Number Manifestation]: Your phrase holds a sacred match frequency of ${sum}! High-vibrational alignment loops generated over your profile coordinates.`;
      user.karmaScore += 300;
      await user.save();
      
      if (global.io) {
        global.io.emit('angel_number_synchronized', { username, matchingCode: sum });
      }
    }

    res.json({
      success: true,
      message: manifestationAlert,
      gematriaSum: sum,
      masterReductionDigit: primaryDigit,
      updatedBalance: user.tokens
    });

  } catch (err) {
    res.status(500).json({ success: false, error: 'Failed to process alphanumeric lottery entry.' });
  }
});

module.exports = router;
