import React, { useState } from 'react';

export function AkashicRecordsTerminalHUD() {
  const [isTerminalOpen, setIsTerminalOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [terminalResults, setTerminalResults] = useState([]);

  const executeAkashicQuery = async () => {
    try {
      // Fetch open data records directly out of the public pipeline endpoints
      const response = await fetch(`/api/akashic/query?search=${encodeURIComponent(searchQuery)}`);
      const data = await response.json();
      if (data.success) {
        setTerminalResults(data.records); // Populates text rows stripped of all private fields [1]
      }
    } catch (e) {
      console.error("Akashic node connection drop:", e);
    }
  };

  if (!isTerminalOpen) {
    return (
      <button 
        style={{ position: 'absolute', top: '24px', left: '24px', zIndex: 102 }} 
        className="dashboard-toggle-btn"
        onClick={() => setIsTerminalOpen(true)}
      >
        📖 Open Akashic Records Terminal
      </button>
    );
  }

  return (
    <div className="login-screen-backdrop" style={{ backgroundColor: 'rgba(15, 23, 42, 0.95)' }}>
      <div className="login-card" style={{ maxWidth: '700px', width: '90%' }}>
        
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '14px' }}>
          <h2 className="login-title" style={{ margin: 0 }}>📖 The Akashic Records Public Terminal</h2>
          <button onClick={() => setIsTerminalOpen(false)} style={{ background: 'transparent', color: '#94a3b8', border: 'none', cursor: 'pointer', fontSize: '18px' }}>✕</button>
        </div>
        
        <p style={{ fontSize: '12px', color: '#94a3b8', marginTop: '-8px', marginBottom: '18px' }}>
          Accessing historical public world memory matrices. Sensitive personal data fields remain locked.
        </p>

        {/* Query Input field row */}
        <div style={{ display: 'flex', gap: '8px', marginBottom: '20px' }}>
          <input 
            type="text" 
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Search by player name, historical date, or public event keyword..."
            style={{ flex: 1, background: 'rgba(0,0,0,0.5)', border: '1px solid #818cf8', borderRadius: '10px', padding: '12px', color: '#fff' }}
          />
          <button onClick={executeAkashicQuery} className="buy-upgrade-btn">Execute Query</button>
        </div>

        {/* Live Output Data Monitor */}
        <div style={{ 
          background: 'rgba(0,0,0,0.6)', borderRadius: '12px', height: '320px', 
          overflowY: 'auto', padding: '14px', textAlignment: 'left', fontFamily: 'monospace', fontSize: '12px' 
        }}>
          {terminalResults.length > 0 ? (
            terminalResults.map((record) => (
              <div key={record.recordId} style={{ borderBottom: '1px solid rgba(255,255,255,0.05)', paddingBottom: '6px', marginBottom: '6px', color: '#cbd5e1' }}>
                <span style={{ color: '#fbbf24' }}>[{new Date(record.timestamp).toLocaleString()}]</span>{' '}
                <strong style={{ color: '#a5b4fc' }}>{record.username}:</strong>{' '}
                <span>{record.payloadData.contentString}</span>
              </div>
            ))
          ) : (
            <div style={{ color: '#64748b', textAlign: 'center', paddingTop: '120px' }}>
              Terminal idling. Input target query parameters to trace histories...
            </div>
          )}
        </div>

      </div>
    </div>
  );
}
