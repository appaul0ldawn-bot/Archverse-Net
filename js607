global.io.on('connection', (socket) => {
  
  socket.on('sensor_matrix_stream', async (payload) => {
    const { username, packetQueue } = payload;
    const user = await User.findOne({ username });

    if (!user || user.isBanned) return;

    // PATTERN RECOGNITION INTERPOLATION LAYER
    packetQueue.forEach(async (packet) => {
      switch (packet.component) {
        
        case 'GEOSPATIAL_COORDINATES':
          // Update database coordinates snapshots cache
          user.lastPosition.x = packet.data.lat;
          user.lastPosition.z = packet.data.lng;
          
          // Generate an automated oracle timeline check to trigger Glimmer Visions if matching criteria anchors
          evaluateOracleProximityGlimmers(username, packet.data.lat, packet.data.lng);
          break;

        case 'ACOUSTIC_FREQUENCY':
          // Check if background sounds match plant wave resonance frequencies or animal language nodes
          if (packet.data.pitchHz >= 432 && packet.data.pitchHz <= 440) {
            triggerAlchemicalPlantSpawningNode(packet.data.lat, packet.data.lng, 'Sacred_Cinnabar');
          }
          break;

        case 'MOTION_BIOMETRICS':
          // Feed metrics straight into the Deep Psychometry Player Profile Analytics model
          await updatePlayerPsychologyProfile(user._id, packet.data.posture);
          break;
          
        default:
          break;
      }
    });

    global.stateHasChanged = true; // Signals the central 22Hz tick system to broadcast updates worldwide
  });
});

async function triggerAlchemicalPlantSpawningNode(lat, lng, plantType) {
  // Spawns a harvestable plant asset directly onto the 3D map grid dynamically
  await mongoose.model('MapMicroNode').create({
    lat: lat + (Math.random() - 0.5) * 0.01,
    lng: lng + (Math.random() - 0.5) * 0.01,
    type: 'botanical_harvest',
    assetRefName: plantType
  });
}
