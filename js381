const express = require('express');
const router = express.Router();
const User = require('./models/User');

router.post('/admin/toggle-oversight-mesh', async (req, res) => {
  try {
    const { adminUsername, targetSocketId, toggleState } = req.body;

    // 1. Verify administrator credentials against master roster parameters
    const admin = await User.findOne({ username: adminUsername });
    if (!admin || !['Archangel', 'Council'].includes(admin.rank)) {
      return res.status(403).json({ success: false, error: 'Access Denied. Admin clearance required.' });
    }

    // 2. Broadcast the mesh diagnostic view state update across socket lines
    if (global.io) {
      global.io.emit('oversight_mesh_state', {
        isActive: toggleState, // true = wireframe on, false = normal rendering
        triggeredBy: adminUsername
      });
    }

    res.json({ success: true, modName: "Vanguard Oversight Mesh Scanner", activeState: toggleState });
  } catch (err) {
    res.status(500).json({ success: false, error: 'Oversight mod execution error.' });
  }
});

module.exports = router;
