const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file
const User = require('./models/User');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
  
  // Initialize the tracking model within our testing sandbox memory cluster
  mongoose.model('CognitiveLedger', new mongoose.Schema({
    userId: mongoose.Schema.Types.ObjectId,
    subliminalMetrics: { gematriaPuzzleSolveSpeedSeconds: Number, spatialPathfindingEfficiency: Number, frequencyTuningAccuracy: Number },
    calculatedIqScore: Number,
    computedZScore: Number,
    bellCurvePercentileRank: Number,
    assignedIntellectFaction: String,
    extraAchievementsBadges: [String]
  }));
});

afterEach(async () => {
  await User.deleteMany({});
  if (mongoose.modelNames().includes('CognitiveLedger')) {
    await mongoose.model('CognitiveLedger').deleteMany({});
  }
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

// ==========================================================================
// 🧠 SUITE 29: IMPLICIT COGNITIVE TESTING & BELL CURVE CHECKS
// ==========================================================================
describe('Archverse Implicit Subliminal Grading & Faction Segregation Engine', () => {

  it('should process high performance speed metrics and automatically assign the user to the high-IQ Logical Archon Guild', async () => {
    const player = await User.create({ username: 'HighGnosisScholar', tokens: 100 });

    // Seed excellent baseline metrics to verify the standard deviation calculation returns a high-tier index score
    await mongoose.model('CognitiveLedger').create({
      userId: player._id,
      subliminalMetrics: {
        gematriaPuzzleSolveSpeedSeconds: 5.0, // Blazing fast decryption speed
        spatialPathfindingEfficiency: 0.95,
        frequencyTuningAccuracy: 0.98
      }
    });

    const response = await request(app)
      .post('/api/analytics/ingest-subliminal-metric')
      .send({
        username: 'HighGnosisScholar',
        solveSpeed: 5.0,
        pathingEfficiency: 0.95,
        accuracyRatio: 0.98
      });

    expect(response.status).toBe(200);
    expect(response.body.success).toBe(true);
    expect(response.body.profilePlacements.activeFactionAlliance).toBe('LOGICAL_ARCHON_GUILD'); // Faction placement rules validated
    expect(response.body.contextualSponsorAd.destinationUrl).toContain('tokenmaker.one'); // Verified targeted premium sponsor link advertisement triggered
  });
});
