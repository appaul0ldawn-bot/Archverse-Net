import React, { useState, useEffect } from 'react';

export function IdentityInspectorHUD({ currentUsername, socket }) {
  const [givenName, setGivenName] = useState('');
  const [middleName, setMiddleName] = useState('');
  const [surName, setSurName] = useState('');
  const [moniker, setMoniker] = useState('');
  const [identityData, setIdentityData] = useState(null);
  const [isProcessing, setIsProcessing] = useState(false);

  const executeIdentityCompilation = async () => {
    if (!givenName.trim() || !surName.trim()) return;
    setIsProcessing(true);

    try {
      const response = await fetch('/api/identity/compile-profile-names', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username: currentUsername,
          givenName: givenName.trim(),
          middleName: middleName.trim(),
          surName: surName.trim(),
          moniker: moniker.trim()
        })
      });
      const data = await response.json();
      if (data.success) {
        setIdentityData(data);
      }
    } catch (e) {
      console.error("Failed to commit etymo-genealogical name mapping packet:", e);
    } finally {
      setIsProcessing(false);
    }
  };

  return (
    <div className="storefront-overlay-wrapper" style={{ top: '10%', left: '24px', width: '360px', maxHeight: '85%', border: '1px solid #eab308', background: 'linear-gradient(135deg, #0b1329 0%, rgba(234,179,8,0.02) 100%)' }}>
      <div className="store-header" style={{ borderColor: 'rgba(234,179,8,0.2)' }}>
        <h3 style={{ margin: 0, color: '#fbbf24', fontFamily: 'serif' }}>📜 Identity Codex: Etymo-Genealogy</h3>
        <span style={{ fontSize: '9px', color: '#64748b' }}>Sovereign Profile Name Parsing Array • Virtues Oversight</span>
      </div>

      <div style={{ padding: '12px', display: 'flex', flexDirection: 'column', gap: '8px', overflowY: 'auto' }}>
        
        {/* Name Fields Input Terminal Matrix */}
        {!identityData && (
          <div style={{ display: 'flex', flexDirection: 'column', gap: '6px', textAlign: 'left', fontSize: '11px' }}>
            <div>
              <span style={{ color: '#cbd5e1' }}>First Given Name:</span>
              <input type="text" value={givenName} onChange={(e) => setGivenName(e.target.value)} style={{ width: '100%', background: 'rgba(0,0,0,0.4)', border: '1px solid rgba(255,255,255,0.1)', color: '#fff', padding: '6px', borderRadius: '4px' }} />
            </div>
            <div>
              <span style={{ color: '#cbd5e1' }}>Ancestral Middle Name:</span>
              <input type="text" value={middleName} onChange={(e) => setMiddleName(e.target.value)} style={{ width: '100%', background: 'rgba(0,0,0,0.4)', border: '1px solid rgba(255,255,255,0.1)', color: '#fff', padding: '6px', borderRadius: '4px' }} />
            </div>
            <div>
              <span style={{ color: '#cbd5e1' }}>Family Surname:</span>
              <input type="text" value={surName} onChange={(e) => setSurName(e.target.value)} style={{ width: '100%', background: 'rgba(0,0,0,0.4)', border: '1px solid rgba(255,255,255,0.1)', color: '#fff', padding: '6px', borderRadius: '4px' }} />
            </div>
            <div>
              <span style={{ color: '#cbd5e1' }}>Spiritual Moniker Handle:</span>
              <input type="text" value={moniker} onChange={(e) => setMoniker(e.target.value)} style={{ width: '100%', background: 'rgba(0,0,0,0.4)', border: '1px solid rgba(255,255,255,0.1)', color: '#fff', padding: '6px', borderRadius: '4px' }} />
            </div>
            
              {isProcessing ? '🔄 Analyzing Root Ciphers...' : '🧬 Process Name Ciphers'}
            </button>
          </div>
        )}

        {/* Diagnostic Output Analysis Card Display */}
        {identityData && (
          <div style={{ textAlign: 'left', fontSize: '12px', display: 'flex', flexDirection: 'column', gap: '8px', color: '#cbd5e1' }}>
            <div style={{ background: 'rgba(0,0,0,0.4)', padding: '10px', borderRadius: '8px', border: '1px solid #fbbf24' }}>
              <span style={{ fontSize: '11px', color: '#fbbf24', fontWeight: 'bold', display: 'block' }}>🏛️ Ancestral Tribe Allocation:</span>
              <strong style={{ fontSize: '14px', color: '#fff', display: 'block', marginTop: '2px' }}>Tribe of {identityData.genealogyReport.assignedIsraeliteTribe}</strong>
              <span style={{ fontSize: '9px', color: '#94a3b8' }}>Generational Covenant Status: {identityData.genealogyReport.generationalCurseStatus}</span>
            </div>

            <div className="dashboard-section-title">Etymological Root Tracing</div>
            <div>• Origin: <strong>{identityData.etymologyReport.rootOriginLanguage}</strong></div>
            <div>• Primordial Meaning: <span style={{ fontStyle: 'italic', color: '#e2e8f0' }}>"{identityData.etymologyReport.primordialMeaningText}"</span></div>
            <div>• Archetype: <strong>{identityData.etymologyReport.congruentMythologicalArchetype}</strong></div>

            <div className="dashboard-section-title">Procedurally Injected Attributes</div>
            <div className="metric-row"><span>Solfeggio Resonance Base:</span><strong style={{ color: '#34d399' }}>{identityData.injectedAttributes.baseResonanceHz} Hz</strong></div>
            <div className="metric-row">
              <span>Dynamic Aura Color Tint:</span>
              
            </div>

            <button onClick={() => setIdentityData(null)} className="dashboard-toggle-btn" style={{ marginTop: '4px' }}>✕ Clear and Edit Fields</button>
          </div>
        )}
      </div>
    </div>
  );
}
