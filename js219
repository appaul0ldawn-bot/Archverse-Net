import React, { useState } from 'react';

const ESOTERIC_CARDS = [
  { sym: "Mst", name: "Monatomic Gold", color: "#fef08a", src: "ORMEs Alchemy", desc: "Super-fluid high-spin atoms that bypass local gravity fields." },
  { sym: "Vr", name: "Vril Force", color: "#38bdf8", src: "Secret Society Archives", desc: "The all-penetrating cosmic fluid that controls atmospheric airwaves." },
  { sym: "Rm", name: "Red Mercury", color: "#ef4444", src: "Dark Web Dossiers", desc: "Ultra-dense mythical catalyst that shields networks from firewall caps." },
  { sym: "Ect", name: "Ectoplasm", color: "#cbd5e1", src: "19th-Century Spiritualism", desc: "Physicalized aura residue used to compress spirits into ghost bytes." }
];

export function EsotericPeriodicHUD({ socket }) {
  const [selectedElement, setSelectedElement] = useState(null);

  const handleInspectElement = (element) => {
    setSelectedElement(element);
    // Transmit frequency alignment codes across local WebSocket lines
    socket.emit('align_esoteric_frequency', { symbol: element.sym });
  };

  return (
    <div className="chat-log-sidebar" style={{ top: '55%', left: '24px', width: '340px', maxHeight: '40%' }}>
      <div style={{ fontSize: '11px', color: '#fbbf24', fontWeight: 700, letterSpacing: '0.05em', marginBottom: '8px' }}>
        🧪 FANTASY & UNIFIED ESOTERIC ELEMENTS
      </div>

      {/* Grid Display Grid */}
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: '6px' }}>
        {ESOTERIC_CARDS.map(el => (
          <button
            key={el.sym}
            onClick={() => handleInspectElement(el)}
            className="custom-option-btn"
            style={{ 
              borderColor: el.color, 
              background: selectedElement?.sym === el.sym ? `${el.color}15` : 'rgba(0,0,0,0.3)',
              padding: '10px', 
              color: el.color,
              textAlign: 'left'
            }}
          >
            <span style={{ fontSize: '14px', fontWeight: 'bold', display: 'block' }}>{el.sym}</span>
            <span style={{ fontSize: '9px', color: '#cbd5e1' }}>{el.name}</span>
          </button>
        ))}
      </div>

      {/* Inspector Card Data Display */}
      {selectedElement && (
        <div style={{ marginTop: '10px', background: 'rgba(15,23,42,0.9)', padding: '10px', borderRadius: '10px', border: `1px solid ${selectedElement.color}`, textAlign: 'left', fontSize: '11px' }}>
          <strong style={{ color: selectedElement.color }}>Source: {selectedElement.src}</strong>
          <p style={{ margin: '4px 0 0 0', color: '#e2e8f0', lineHeight: 1.3 }}>
            {selectedElement.desc}
          </p>
        </div>
      )}
    </div>
  );
}
