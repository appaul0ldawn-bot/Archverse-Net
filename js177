import React, { useState, useEffect } from 'react';

export function RecoveryStatusHUD({ socket }) {
  const [syncStatus, setSyncStatus] = useState('SYNCHRONIZED');
  const [lastSaved, setLastSaved] = useState(new Date().toLocaleTimeString());

  useEffect(() => {
    // Intercept automated backup confirmation pings dispatched from server tickers
    socket.on('autosave_committed_ping', (data) => {
      setSyncStatus('SYNCHRONIZED');
      setLastSaved(new Date().toLocaleTimeString());
    });

    socket.on('disconnect', () => {
      setSyncStatus('DISCONNECTED_CRASH_ALERT');
    });

    socket.on('reconnect', () => {
      setSyncStatus('RECONSTRUCTING_STATE');
    });

    return () => {
      socket.off('autosave_committed_ping');
    };
  }, [socket]);

  return (
    <div style={{
      position: 'absolute', bottom: '24px', left: '24px', width: '280px', zIndex: 105,
      background: 'rgba(15, 23, 42, 0.95)', border: syncStatus === 'SYNCHRONIZED' ? '1.5px solid #10b981' : '1.5px solid #ef4444',
      borderRadius: '12px', padding: '10px 14px', fontFamily: 'monospace', color: '#fff'
    }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', fontSize: '11px' }}>
        <span>📊 Ledger Sync:</span>
        <span style={{ 
          fontWeight: 'bold', 
          color: syncStatus === 'SYNCHRONIZED' ? '#34d399' : '#f87171',
          textTransform: 'uppercase'
        }}>
          {syncStatus.replace('_', ' ')}
        </span>
      </div>
      <div style={{ fontSize: '10px', color: '#94a3b8', marginTop: '4px', textAlign: 'left' }}>
        • Last Write-Ahead Log: {lastSaved}
        {"\n"}• WiredTiger Journaling: ACTIVE
      </div>
    </div>
  );
}
