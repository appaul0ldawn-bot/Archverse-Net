const mongoose = require('mongoose');

// ==========================================================================
// 🎲 ARCHVERSE CORE MISSION WAGER SCHEMA
// ==========================================================================
const MissionWagerSchema = new mongoose.Schema({
  wagerId: { type: String, required: true, unique: true, index: true },
  linkedMissionId: { type: String, required: true, index: true },
  
  // Observational Bettor Data
  bettorUsername: { type: String, required: true },
  betAmountST: { type: Number, required: true, min: 1 }, // Strictly tokens only
  predictionDirection: { type: String, enum: ['SUCCESS', 'FAILURE'], required: true },
  
  wagerStatus: { 
    type: String, 
    enum: ['PLACED_ACTIVE', 'SETTLED_WIN', 'SETTLED_LOSS', 'STALEMATE_HOUSE_WIN'], 
    default: 'PLACED_ACTIVE' 
  },
  
  placedAt: { type: Date, default: Date.now }
});

module.exports = mongoose.model('MissionWager', MissionWagerSchema);
