const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file
const User = require('./models/User');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
  
  // Explicitly initialize the models within our testing memory sandbox
  mongoose.model('MissionWager', new mongoose.Schema({
    wagerId: String,
    linkedMissionId: String,
    bettorUsername: String,
    betAmountST: Number,
    predictionDirection: String,
    wagerStatus: String
  }));

  mongoose.model('AlignedMission', new mongoose.Schema({
    missionId: String,
    assignedToUserId: mongoose.Schema.Types.ObjectId,
    title: String,
    isSealedAndCompleted: Boolean
  }));
});

afterEach(async () => {
  await User.deleteMany({});
  if (mongoose.modelNames().includes('MissionWager')) await mongoose.model('MissionWager').deleteMany({});
  if (mongoose.modelNames().includes('AlignedMission')) await mongoose.model('AlignedMission').deleteMany({});
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

// ==========================================================================
// 🎰 SUITE 27: OBSERVATIONAL BETTING Arena & ANTI-CHEAT GATES
// ==========================================================================
describe('Archverse Mission Observation Betting Arena & Insider Trading Controls', () => {

  it('should explicitly reject a wager if the player attempts to bet on their own assigned mission', async () => {
    const actorUser = await User.create({ username: 'MissionActorAngel', tokens: 500 });
    
    // Seed an active mission assigned to this specific player node
    const mission = await mongoose.model('AlignedMission').create({
      missionId: "ms_test_777",
      assignedToUserId: actorUser._id,
      title: "Cleanse Localised Grid Density",
      isSealedAndCompleted: false
    });

    const response = await request(app)
      .post('/api/wagers/place')
      .send({
        bettorUsername: 'MissionActorAngel', // Actor attempting to place an insider bet
        targetMissionId: 'ms_test_777',
        tokenStake: 100,
        prediction: 'SUCCESS'
      });

    expect(response.status).toBe(403); // Safely intercepted and denied by anti-cheat rules
    expect(response.body.success).toBe(false);
    expect(response.body.error).toContain('Exploitation Guard: You are structurally barred');
  });
});
