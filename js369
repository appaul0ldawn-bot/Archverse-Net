const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file
const User = require('./models/User');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
});

afterEach(async () => {
  await User.deleteMany({});
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

// ==========================================================================
// 👁️ SUITE 20: ADMINISTRATIVE X-RAY OVERLAY VALIDATION GATES
// ==========================================================================
describe('Archverse Eyes of Superman Mod Access Controls', () => {

  it('should successfully authorize access for whitelisted developer email handles', async () => {
    const response = await request(app)
      .post('/api/admin/toggle-xray-vision')
      .send({
        adminEmail: 'zethreigns@gmail.com', // Verified Base44 Admin Signature
        targetUsername: 'StagingPlayerNode',
        toggleState: true
      });

    expect(response.status).toBe(200);
    expect(response.body.success).toBe(true);
    expect(response.body.activeState).toBe(true);
  });

  it('should strictly reject X-Ray activation attempts from unauthorized email handles', async () => {
    const response = await request(app)
      .post('/api/admin/toggle-xray-vision')
      .send({
        adminEmail: 'unauthorized_user@gmail.com',
        targetUsername: 'StagingPlayerNode',
        toggleState: true
      });

    expect(response.status).toBe(403); // Intercepted and blocked by security gates
    expect(response.body.success).toBe(false);
  });
});
