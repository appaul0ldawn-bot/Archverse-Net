const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file
const User = require('./models/User');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
});

afterEach(async () => {
  await User.deleteMany({});
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

// ==========================================================================
// 💞 SUITE 22: BEHAVIORAL SYNC LOOPS & LOVE METER GATES
// ==========================================================================
describe('Archverse Love Meter Mod Resonance Ingestion Checks', () => {

  it('should successfully compute compatibility percentages for adjacent player profiles matching metrics', async () => {
    await User.create({ username: 'Seraph_Adam', tokens: 10, auraMoodStatus: 'Radiant', activeVisualState: 'WALKING' });
    await User.create({ username: 'Seraph_Eve', tokens: 10, auraMoodStatus: 'Radiant', activeVisualState: 'WALKING' });

    const response = await request(app)
      .post('/api/admin/evaluate-resonance')
      .send({
        adminEmail: 'appaul0ldawn@gmail.com', // Whitelisted Admin Signature
        playerOneUsername: 'Seraph_Adam',
        playerTwoUsername: 'Seraph_Eve'
      });

    expect(response.status).toBe(200);
    expect(response.body.success).toBe(true);
    expect(response.body.resonanceScorePercentage).toBeGreaterThan(50);
    expect(response.body.diagnosticReport).toContain('High Seraph Resonance');
  });

  it('should explicitly deny data compilation access if user is not a verified master admin', async () => {
    const response = await request(app)
      .post('/api/admin/evaluate-resonance')
      .send({
        adminEmail: 'standard_player@gmail.com',
        playerOneUsername: 'Seraph_Adam',
        playerTwoUsername: 'Seraph_Eve'
      });

    expect(response.status).toBe(403); // Intercepted and blocked by security gates
  });
});
