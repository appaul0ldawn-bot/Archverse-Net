const mongoose = require('mongoose');

// ==========================================================================
// 🖤 COGNITIVE VOID BACKROOM FALLBACK REGISTRY SCHEMA
// ==========================================================================
const VoidRecoverySchema = new mongoose.Schema({
  userId: { type: mongoose.Schema.Types.ObjectId, ref: 'User', unique: true, index: true },
  username: { type: String, required: true },
  
  isTrappedInVoidNode: { type: Boolean, default: false },
  
  // Cache coordinates to restore the container to its previous proximity footprint
  previousSafeCoordinates: {
    x: { type: Number, default: 31.7683 }, // Default Zion Zero-Point Center
    z: { type: Number, default: 35.2137 }
  },

  soulContractAcceptedStatus: { type: Boolean, default: false },
  trappedAtTimestamp: { type: Date, default: Date.now }
});

module.exports = mongoose.model('VoidRecovery', VoidRecoverySchema);
