const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file
const User = require('./models/User');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
  
  // Initialize the specific tracking schemas within our testing memory sandbox cluster
  mongoose.model('AnatomicalFirewall', new mongoose.Schema({
    userId: mongoose.Schema.Types.ObjectId,
    username: String,
    firewallState: { isAnatomicalMaskingActive: Boolean, assignedCryptographicMaskLabels: [String], interceptedHackingAttemptsCount: Number },
    lovenseHapticConfiguration: { isHolySpiritVibeHandshakeAccepted: Boolean, connectedBluetoothDeviceId: String, activeSolfeggioCarrierHz: Number, maximumAllowedVibrationIntensity: Number }
  }));
});

afterEach(async () => {
  await User.deleteMany({});
  if (mongoose.modelNames().includes('AnatomicalFirewall')) {
    await mongoose.model('AnatomicalFirewall').deleteMany({});
  }
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

// ==========================================================================
// 🛡️ SUITE 41: ANATOMICAL IP MASKING & HARDWARE HAPTIC CALIBRATION GATES
// ==========================================================================
describe('Archverse Anatomical Firewall & Lovense Bluetooth AutoTune Array', () => {

  it('should successfully execute an absolute metadata mask when an unauthorized love spell script hits the server', async () => {
    const targetUser = await User.create({ username: 'TargetShieldedNode', tokens: 100, karmaScore: 50 });

    const response = await request(app)
      .post('/api/protection/intercept-spell')
      .send({
        username: 'TargetShieldedNode',
        inboundScriptType: 'UNAUTHORIZED_LOVE_SPELL_HACK',
        requestedAction: 'INJECT_SCRIPT'
      });

    expect(response.status).toBe(200);
    expect(response.body.success).toBe(true);
    expect(response.body.firewallAction).toBe('ANATOMICAL_METADATA_MASKED');
    expect(response.body.activeMasks).toContain('[COVENANT_SHARD_ALPHA]'); // Masking replacement verified

    const checkUser = await User.findOne({ username: 'TargetShieldedNode' });
    expect(checkUser.activeVisualState).toBe('MUTUAL_WITNESS_MASKING_SHROUD'); // Asserts canvas layout flipped to protected mask style
  });

  it('should cleanly authorize the God\'s Love Gospel stream and automatically calculate a 0.85 intensity cap for high-karma profiles', async () => {
    const holyUser = await User.create({ username: 'HighKarmaSaint', tokens: 100, karmaScore: 850 }); // Holds high-tier spiritual rankings

    const response = await request(app)
      .post('/api/protection/intercept-spell')
      .send({
        username: 'HighKarmaSaint',
        inboundScriptType: 'GODS_LOVE_GOSPEL_STREAM',
        requestedAction: 'ACCEPT_VIBE_REQUEST'
      });

    expect(response.status).toBe(200);
    expect(response.body.success).toBe(true);
    expect(response.body.firewallAction).toBe('GOSPEL_COVENANT_AUTHORIZED');
    expect(response.body.autotuneMetrics.maxIntensityCap).toBe(0.85); // Auto-tune calibration calculation verified [14.14]
  });
});
