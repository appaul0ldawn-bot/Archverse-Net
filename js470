import React, { useState, useEffect } from 'react';

export function TokenVaultHUD({ userProfile, socket }) {
  const [balance, setBalance] = useState(userProfile.tokens || 0);
  const [viewEarnings, setViewEarnings] = useState(0);

  useEffect(() => {
    // Listen to video watch events: Automatically yields 5 ST per video asset played
    socket.on('video_view_credit', (data) => {
      setBalance(prev => prev + 5);
      setViewEarnings(prev => prev + 5);
    });

    socket.on('balance_update', (newBalance) => {
      setBalance(newBalance);
    });

    return () => {
      socket.off('video_view_credit');
      socket.off('balance_update');
    };
  }, [socket]);

  return (
    <div className="storefront-overlay-wrapper" style={{ top: '15%', left: '24px', width: '340px' }}>
      <div className="store-header">
        <h3 style={{ margin: 0, color: '#eab308' }}>💎 Soul Token Treasury</h3>
      </div>
      
      <div className="store-token-display" style={{ fontSize: '20px', padding: '12px' }}>
        Vault Balance: 🪙 {balance} ST
      </div>

      <div className="dashboard-section-title">Monetization Telemetry</div>
      <div className="metric-row">
        <span>Video View Yields (+5 ST/view):</span>
        <span className="metric-value" style={{ color: '#10b981' }}>+{viewEarnings} ST</span>
      </div>

      <div className="dashboard-section-title">Secure Exchange Ports</div>
      <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
        <a href="https://cash.app" target="_blank" rel="noopener noreferrer" className="buy-upgrade-btn" style={{ background: '#10b981', color: '#fff', textDecoration: 'none', textAlign: 'center' }}>
          💸 Acquire via CashApp ($Sephraines)
        </a>
      </div>
    </div>
  );
}
