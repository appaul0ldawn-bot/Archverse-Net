import React, { useState, useRef } from 'react';
import { useFrame } from '@react-three/fiber';
import { Html } from '@react-three/drei';
import * as THREE from 'three';

export function PortalEcosystemNode({ position, nodeTitle, redirectUrl, conceptDescription, alignmentType }) {
  const meshRef = useRef();
  const [isHovered, setIsHovered] = useState(false);
  const [isOpen, setIsOpen] = useState(false);

  useFrame((state) => {
    if (!meshRef.current) return;
    const time = state.clock.getElapsedTime();
    
    // Wave oscillation logic to look like a floating digital relic link
    meshRef.current.position.y = position + Math.sin(time * 2.5) * 0.15;
    meshRef.current.rotation.y = time * 0.5;
  });

  const nodeColor = alignmentType === 'ANGELIC' ? '#fde047' : '#a855f7';

  return (
    <group>
      {/* Shifting Crystal Geometry Target Anchor */}
      <mesh
        ref={meshRef}
        position={position}
        onPointerOver={() => setIsHovered(true)}
        onPointerOut={() => setIsHovered(false)}
        onClick={() => setIsOpen(!isOpen)}
      >
        <octahedronGeometry args={[0.25, 0]} />
        <meshStandardMaterial
          color={nodeColor}
          emissive={nodeColor}
          emissiveIntensity={isHovered ? 3.0 : 1.2}
          wireframe
        />
      </mesh>

      {/* Dynamic Link Projection HUD Box */}
      {isOpen && (
        <Html position={[0, 0.6, 0]} center distanceFactor={8}>
          <div style={{
            background: 'rgba(15, 23, 42, 0.96)',
            border: `1.5px solid ${nodeColor}`,
            borderRadius: '12px', padding: '12px 16px', color: '#fff',
            fontFamily: 'sans-serif', width: '240px', boxShadow: '0 10px 25px rgba(0,0,0,0.5)',
            zIndex: 110, pointerEvents: 'auto'
          }}>
            <strong style={{ color: nodeColor, display: 'block', fontSize: '13px', marginBottom: '4px' }}>
              🔗 {nodeTitle}
            </strong>
            <p style={{ margin: '0 0 10px 0', fontSize: '11px', color: '#cbd5e1', lineHeight: '1.4' }}>
              {conceptDescription}
            </p>
            <a
              href={redirectUrl}
              target="_blank"
              rel="noopener noreferrer"
              style={{
                display: 'block', textAlign: 'center', background: nodeColor, color: '#0f172a',
                padding: '6px 10px', borderRadius: '6px', fontSize: '11px', fontWeight: 'bold',
                textDecoration: 'none'
              }}
            >
              Access Resource Hub
            </a>
          </div>
        </Html>
      )}
    </group>
  );
}
