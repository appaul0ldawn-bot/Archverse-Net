const express = require('express');
const router = express.Router();
const mongoose = require('mongoose');
const User = require('./models/User');
const { ArchverseLogger } = require('./Logger');

// ==========================================================================
// 🚨 EMERGENCY LEDGER & SPIRITUAL RESTRAINING ORDER SCHEMAS
// ==========================================================================
const RestrainingOrderSchema = new mongoose.Schema({
  orderId: { type: String, required: true, unique: true, index: true },
  protectedUserId: { type: mongoose.Schema.Types.ObjectId, ref: 'User', index: true },
  restrictedUserEmail: { type: String, required: true }, // The target entity to block
  geofenceRadiusMeters: { type: Number, default: 100 },  // Enforces a strict 100m separation bubble
  isSealedByVirtuesRank: { type: Boolean, default: true },
  issuedAt: { type: Date, default: Date.now }
});

const EmergencyIncidentSchema = new mongoose.Schema({
  incidentId: { type: String, required: true, unique: true },
  title: { type: String, required: true },
  severityTier: { type: String, enum: ['LOW_DENSITY_ECHO', 'MEDIUM_DISTURBANCE', 'CRITICAL_INTERVENTION'], default: 'MEDIUM_DISTURBANCE' },
  coordinates: {
    lat: { type: Number, required: true },
    lng: { type: Number, required: true }
  },
  dispatcherSource: { type: String, default: 'Simulated Emergency Radio Scanner Channel' },
  isResolvedByLightworker: { type: Boolean, default: false }
});

const RestrainingOrder = mongoose.model('RestrainingOrder', RestrainingOrderSchema);
const EmergencyIncident = mongoose.model('EmergencyIncident', EmergencyIncidentSchema);

// ==========================================================================
// 🛡️ FILE SPIRITUAL RESTRAINING ORDER GATEWAY
// ==========================================================================
router.post('/api/protection/file-order', async (req, res) => {
  try {
    const { requestorUsername, targetOffenderEmail, customRadiusMeters } = req.body;
    
    const user = await User.findOne({ username: requestorUsername });
    if (!user) return res.status(404).json({ success: false, error: 'Protected node account not found.' });

    // Commit the protection seal to the persistent database layer
    const newOrder = await RestrainingOrder.create({
      orderId: `seal_order_${Date.now()}`,
      protectedUserId: user._id,
      restrictedUserEmail: targetOffenderEmail.toLowerCase().trim(),
      geofenceRadiusMeters: customRadiusMeters || 100
    });

    ArchverseLogger.log('WARN', 'SECURITY_GATES', `Spiritual Restraining Order issued by ${requestorUsername} against ${targetOffenderEmail}.`);

    res.json({
      success: true,
      message: `🛡️ Protection Covenant Sealed. A strict ${newOrder.geofenceRadiusMeters}m geofence barrier has been deployed around your avatar container.`,
      orderId: newOrder.orderId
    });
  } catch (err) {
    res.status(500).json({ success: false, error: 'Failed to compile protection order registry.' });
  }
});

module.exports = router;
