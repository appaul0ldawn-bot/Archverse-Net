import React, { useState } from 'react';

export function RulesAndFederationHUD({ socket, username }) {
  const [comment, setComment] = useState('');

  const submitComment = () => {
    if (!comment.trim()) return;
    socket.emit('submit_user_idea', { username, text: comment.trim() });
    setComment('');
    alert("Comment committed to the Council feedback queue.");
  };

  return (
    <div className="login-card" style={{ maxWidth: '650px', margin: '30px auto' }}>
      <h3 className="login-title">⚖️ Galactic Council Rules & Regulations</h3>
      <p style={{ fontSize: '12px', color: '#94a3b8', textAlign: 'left', lineHeight: 1.4 }}>
        The administration of this domain is governed strictly by the Council's designated Rulers of the Airwaves. 
        Any injection of unauthorized script hacks, malicious speech loops over WebRTC channels, or harassment tracking loops 
        triggers an automatic profile block, asset zeroing, and structural ban.
      </p>

      <div className="dashboard-section-title">🌐 Galactic Federation Global Goals</div>
      <div style={{ background: 'rgba(0,0,0,0.3)', padding: '10px', borderRadius: '8px', fontSize: '11px', textAlign: 'left' }}>
        🟢 <strong>Goal 1:</strong> Complete 144,000 language database locks with botanical plant frequency networks.
        {"\n"}🟢 <strong>Goal 2:</strong> Maintain zero-downtime persistence across the primary and free backup DuckDNS clusters.
      </div>

      <div style={{ marginTop: '16px' }}>
        <input 
          type="text" value={comment} onChange={(e) => setComment(e.target.value)} placeholder="Submit ideas or comments to the Council..."
          style={{ width: '100%', background: 'rgba(0,0,0,0.5)', color: '#fff', border: '1px solid rgba(255,255,255,0.1)', padding: '10px', borderRadius: '6px', fontSize: '12px' }}
        />
        <button onClick={submitComment} className="buy-upgrade-btn" style={{ width: '100%', marginTop: '6px' }}>
          Submit Feedback
        </button>
      </div>
    </div>
  );
}
