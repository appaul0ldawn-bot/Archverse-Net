const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file
const User = require('./models/User');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
});

afterEach(async () => {
  await User.deleteMany({});
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

// ==========================================================================
// 👁️ SUITE 21: ADVANCED ANATOMICAL REPLACER & PHYSICS GATES
// ==========================================================================
describe('Archverse Eyes of Superman Advanced Anatomy & HDT Physics Validation', () => {

  it('should successfully map UUNP dependencies and return the specific collision hands framework flag', async () => {
    const response = await request(app)
      .post('/api/admin/compile-xray-anatomy')
      .send({
        adminEmail: 'sephraines@gmail.com', // Whitelisted Admin
        targetUsername: 'StagingPlayerNode',
        chosenPreset: 'UUNP_ADVANCED',
        enableClamsMod: true
      });

    expect(response.status).toBe(200);
    expect(response.body.success).toBe(true);
    expect(response.body.infrastructureRequirements.handCollisionSkeleton).toBe('UUNP_SPECIAL_HANDS_COLLISION');
    expect(response.body.infrastructureRequirements.physicsDriver).toBe('HDT_PHYSICS_EXTENSIONS'); // Verifies HDT Physics requirement check passes
  });

  it('should explicitly fail processing if an unauthorized standard client attempts entry', async () => {
    const response = await request(app)
      .post('/api/admin/compile-xray-anatomy')
      .send({
        adminEmail: 'malicious_hacker@gmail.com',
        targetUsername: 'StagingPlayerNode',
        chosenPreset: 'CBBE_STANDARD',
        enableClamsMod: false
      });

    expect(response.status).toBe(403); // Intercepted and blocked by security gates
    expect(response.body.success).toBe(false);
  });
});
