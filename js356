import React, { useState } from 'react';

export function AdminBodySlideHUD({ adminEmail, selectedPlayerName, socket }) {
  const [meshPreset, setMeshPreset] = useState('CBBE_DEFAULT');
  const [weight, setWeight] = useState(0.5);
  const [muscle, setMuscle] = useState(0.5);
  const [isAdultVariant, setIsAdultVariant] = useState(false);

  const handleBatchBuildOutfit = async () => {
    // Prevent old asset mismatches (Special Edition vs Oldrim asset guardrails validation checks)
    socket.emit('admin_batch_build_outfit', {
      username: selectedPlayerName,
      config: {
        meshPreset,
        weightSliders: { weight, muscleTone: muscle },
        isUnrestricted: isAdultVariant,
        skeleton: 'XPMSSE_EXTENDED'
      }
    });
    alert(`⚡ [BodySlide Engine]: Outfit Studio compilation successful for ${selectedPlayerName}. Asset mismatch checked via LOOT.`);
  };

  return (
    <div className="storefront-overlay-wrapper" style={{ top: '15%', right: '24px', width: '350px' }}>
      <div className="store-header">
        <h3 style={{ margin: 0, color: '#eab308' }}>🛠️ BodySlide & Outfit Studio Mod</h3>
      </div>

      <p style={{ fontSize: '11px', color: '#94a3b8', margin: '4px 0 12px 0', textAlign: 'left' }}>
        Configure and morph player base topologies. Run Nemesis/Pandora frameworks locally before updating animations.
      </p>

      {/* Mesh Replacer Dropdown */}
      <div style={{ marginBottom: '10px', textAlign: 'left' }}>
        <label style={{ fontSize: '11px', color: '#a5b4fc', display: 'block', marginBottom: '4px' }}>Base Core Mesh Replacer:</label>
        <select 
          value={meshPreset} onChange={(e) => setMeshPreset(e.target.value)}
          style={{ background: '#0f172a', color: '#fff', fontSize: '12px', width: '100%', padding: '6px', borderRadius: '6px', border: '1px solid rgba(255,255,255,0.1)' }}
        >
          <option value="CBBE_DEFAULT">Caliente's Beautiful Bodies (CBBE)</option>
          <option value="BHUNP_ADVANCED">BHUNP Advanced Anatomic Rig</option>
          <option value="UNP_SLENDER">UNP Slender Realistic Family</option>
          <option value="SAM_MALE_ATLAS">Shape Atlas for Men (SAM)</option>
        </select>
      </div>

      {/* Morph Sliders */}
      <div className="dashboard-section-title">Anatomical Weight Sliders</div>
      <div style={{ display: 'flex', flexDirection: 'column', gap: '8px', marginBottom: '14px' }}>
        <div className="metric-row">
          <span style={{ fontSize: '12px' }}>Body Weight:</span>
          <input type="range" min="0" max="1" step="0.05" value={weight} onChange={(e) => setWeight(parseFloat(e.target.value))} style={{ width: '150px', accentColor: '#eab308' }} />
        </div>
        <div className="metric-row">
          <span style={{ fontSize: '12px' }}>Muscle Tone:</span>
          <input type="range" min="0" max="1" step="0.05" value={muscle} onChange={(e) => setMuscle(parseFloat(e.target.value))} style={{ width: '150px', accentColor: '#eab308' }} />
        </div>
      </div>

      {/* SFW vs Adult Variant Toggle */}
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '14px', background: 'rgba(255,255,255,0.03)', padding: '8px', borderRadius: '8px' }}>
        <span style={{ fontSize: '12px', color: '#cbd5e1' }}>Unrestricted/Adult Variant:</span>
        <input type="checkbox" checked={isAdultVariant} onChange={(e) => setIsAdultVariant(e.target.checked)} style={{ accentColor: '#ef4444' }} />
      </div>

      <button onClick={handleBatchBuildOutfit} className="buy-upgrade-btn" style={{ width: '100%', background: '#4f46e5', color: '#fff' }}>
        🔨 Execute Batch Build & Fit Armor
      </button>
    </div>
  );
}
