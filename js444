import React, { useState } from 'react';

export function PublicArtGalleryHUD() {
  const [artAlbum, setArtAlbum] = useState([]);

  const handleArtUpload = (e) => {
    const file = e.target.files;
    if (file && file.type.startsWith('image/')) { // Hard Image-Only Safeguard Filter Check
      const localUrl = URL.createObjectURL(file);
      setArtAlbum(prev => [...prev, { id: Date.now(), src: localUrl, likes: 0, comments: [] }]);
    } else {
      alert("❌ Critical Error: Only valid image files (PNG, JPG) are authorized inside Art Album paths.");
    }
  };

  return (
    <div className="login-card" style={{ maxWidth: '600px', margin: '20px auto' }}>
      <div className="dashboard-section-title">🎨 Your Public Celestial Art Album</div>
      <input type="file" accept="image/*" onChange={handleArtUpload} style={{ fontSize: '12px', color: '#94a3b8', marginBottom: '12px' }} />

      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '10px' }}>
        {artAlbum.map(art => (
          <div key={art.id} style={{ background: '#000', borderRadius: '8px', padding: '6px', textAlign: 'center' }}>
            <img src={art.src} alt="User Submission" style={{ width: '100%', height: '100px', objectFit: 'cover', borderRadius: '6px' }} />
            <button className="buy-upgrade-btn" style={{ padding: '2px 6px', marginTop: '4px', fontSize: '10px' }} onClick={() => art.likes++}>
              ❤️ Like ({art.likes})
            </button>
          </div>
        ))}
      </div>
    </div>
  );
}
