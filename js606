const request = require('supertest');
const mongoose = require('mongoose');
const { MongoMemoryServer } = require('mongodb-memory-server');
const app = require('./app'); // Core Express configuration target file
const User = require('./models/User');

let mongoServer;

beforeAll(async () => {
  mongoServer = await MongoMemoryServer.create();
  await mongoose.connect(mongoServer.getUri());
});

afterEach(async () => {
  await User.deleteMany({});
  if (mongoose.modelNames().includes('MapMicroNode')) {
    await mongoose.model('MapMicroNode').deleteMany({});
  }
});

afterAll(async () => {
  await mongoose.disconnect();
  await mongoServer.stop();
});

// ==========================================================================
// 🌌 SUITE 13: REAL-TIME CONTINUOUS SENSOR PATTERN INGESTION LOOPS
// ==========================================================================
describe('Archverse Continuous Multi-Sensor Processing Integrity Tests', () => {

  it('should process a multi-sensor queue packet stream and accurately execute dynamic botanical spawning nodes', async () => {
    await User.create({ username: 'SensorStreamingNode', tokens: 100, isBanned: false });

    // Mock a structured multi-sensor tracking bundle payload input
    const mockPacketQueue = [
      { timestamp: new Date().toISOString(), component: 'GEOSPATIAL_COORDINATES', data: { lat: 31.7683, lng: 35.2137, speed: 2 } },
      { timestamp: new Date().toISOString(), component: 'ACOUSTIC_FREQUENCY', data: { amplitudeDb: 78, pitchHz: 432 } }, // Matches alchemical plant wave criteria
      { timestamp: new Date().toISOString(), component: 'MOTION_BIOMETRICS', data: { posture: 'WALKING_ALIGNMENT', rotationalTiltY: 0.4 } }
    ];

    const response = await request(app)
      .post('/api/telemetry/inject-sensor-matrix') // Internal proxy data endpoint simulation
      .send({ username: 'SensorStreamingNode', packetQueue: mockPacketQueue });

    expect(response.status).toBe(200);
    expect(response.body.success).toBe(true);

    // Assert that the server-side pattern engine successfully spawned an interactive alchemical node asset
    const spawnedNodesCount = await mongoose.model('MapMicroNode').countDocuments({ type: 'botanical_harvest' });
    expect(spawnedNodesCount).toBeGreaterThan(0);
  });
});
